<window title="键鼠使用记录" width="1024" height="576" min-width="760" min-height="520" resizable="true" centered="true" frameless="false"/>

<script>
export default {
  data() {
    var now = new Date();
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    return {
      activeView: 'overview',
      // 热力 tab 设备切换：0=键盘 1=鼠标
      heatDev: 0,
      detailAllTime: true,   // 明细时间范围：true=全部时间；false=按弹窗范围
      trendModeIdx: 0,   // 0=统计 1=明细 2=时段
      // 时段 scope（0=日 1=周 2=月）与系列单选（0=按键 1=点击 2=里程 3=活跃）
      heatScope: 0,
      heatSeries: 0,
      // 多系列勾选：统计 [按键, 点击, 里程, 活跃] 0/1；C++ 轮询映射到 g_trendChart.enabled
      trendSeries: [1, 1, 0, 0],
      // 图表类型（'bar'/'line'）；历史-统计默认折线，与总览一致
      trendChartType: 'line',
      // 总览多系列叠加：[按键, 点击, 里程, 活跃] 0/1；默认勾选按键（四键至少生效一个）
      overviewSeries: [1, 0, 0, 0],
      // 统计数据由 C++ 按独立键局部推送（S 后缀）：仅内容变化的键会触发绑定重求值
      todayS: null, totalS: null,
      appsS: [], apps24hS: [], storageS: null,
      detailS: null,   // P4 历史-明细聚合：{kbd1,kbd2,kbdSum,left,right,mid,total,distCm,activeSec,idleSec,maxSessionSec,sessionCount}
      pausedS: false, autostartS: false, optAppTrackS: false, excludeListS: [],
      pauseCmd: 0,
      autostartCmd: 0,
      themeCmd: 0,
      exportCmd: 0,
      importCmd: 0,
      clearCmd: 0,
      linkCmd: 0,      // 关于页开关外部链接（C++ 侧轮询触发 ShellExecuteW）
      linkUrl: '',     // 待打开的链接（与 linkCmd 配套，须在 data 中初始化才能被 C++ 读到）
      dark: true,       // 由 C++ 侧同步（持久化主题偏好）
      compact: false,    // 窗口较窄时数值缩写显示（由 C++ 侧同步）
      excludeStr: '',  // 前台应用排除列表（逗号分隔 exe 名）
      exclCmd: 0,
      removeExclCmd: 0,   // 移除单个排除项
      removeExclName: '', // 要移除的 exe 名
      dateStr: now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()),
      monthStr: now.getFullYear() + '-' + pad(now.getMonth() + 1),
      weekStr: (function () {   // 本周周一（周模式选中的起始日）
        var w = new Date(now);
        w.setDate(w.getDate() - ((now.getDay() + 6) % 7));
        return w.getFullYear() + '-' + pad(w.getMonth() + 1) + '-' + pad(w.getDate());
      })(),
      tabs: [
        { id: 'overview', label: '总览' },
        { id: 'heat', label: '热力' },
        { id: 'trend', label: '历史' },
        { id: 'settings', label: '设置' }
      ],
      // 日期选择弹窗
      calOpen: false,
      calY: now.getFullYear(),
      calM: now.getMonth() + 1,
      calWeekNames: ['一', '二', '三', '四', '五', '六', '日'],
      // 键盘配列：0=108键 1=87键 2=61键（关于页设置，C++ 持久化）
      kbLayout: 1,
      // 范围选择弹窗（导出 CSV/JSON、清除数据的日期范围；由 C++ 侧开关）
      rangePickOpen: false,
      rangeKind: '',   // "csv" / "json" / "clear"
      // 起始/结束年月日（0 = 不限/全部历史），由弹窗内可调节框编辑
      rangeStartY: 0, rangeStartM: 0, rangeStartD: 0,
      rangeEndY: 0, rangeEndM: 0, rangeEndD: 0,
      rangeStart: '',
      rangeEnd: '',
      rangePickCmd: 0,
      rangeCancelCmd: 0,
      // 明细时间范围：全部时间关闭后弹窗选范围，起止 年/月/日/时/分
      detailRangeOpen: false,
      detailStartY: 0, detailStartM: 0, detailStartD: 0, detailStartH: 0, detailStartN: 0,
      detailEndY: 0, detailEndM: 0, detailEndD: 0, detailEndH: 0, detailEndN: 0,
      detailStart: '',
      detailEnd: '',
      detailRangeCmd: 0,
      detailRangeCancelCmd: 0,
      exportCsvCmd: 0,
      exportJsonCmd: 0,
      // 按应用筛选：filterApp = 选中应用 exe 名（'' = 全部）；切换置 filterAppCmd++
      filterApp: '',
      filterAppCmd: 0,
      filterPickOpen: false,   // 应用筛选弹窗
      // 悬停/点选应用：右侧趋势图显示该应用 24h 变化（悬停临时、点选固定）
      hoverApp: '',
      hoverAppCmd: 0,
      pinnedApp: '',
      pinnedAppCmd: 0
    };
  },
  computed: {
    paused() { return !!this.pausedS; },
    autostart() { return !!this.autostartS; },
    today() { return this.todayS || { keys: 0, clicks: 0, motion: 0 }; },
    total() { return this.totalS || { keys: 0, clicks: 0, days: 0, activeSec: 0 }; },
    storage() { return this.storageS || { bytes: 0, days: 0, first: '', last: '' }; },
    apps() { return this.appsS || []; },
    apps24h() { return this.apps24hS || []; },
    optAppTrack() { return !!this.optAppTrackS; },
    // 应用筛选选项：合并 今日应用排行(appsS) + 近24h(apps24hS)，按次数降序去重取前 20
    filterOptions() {
      var m = {};
      var add = function (a) {
        for (var i = 0; i < a.length; i++) {
          var it = a[i];
          if (!it || !it.n) continue;
          if (!m[it.n] || m[it.n].c < (it.c || 0)) m[it.n] = { n: it.n, c: it.c || 0 };
        }
      };
      add(this.apps);
      add(this.apps24h);
      var out = [];
      for (var k in m) out.push(m[k]);
      out.sort(function (x, y) { return y.c - x.c; });
      if (out.length > 20) out = out.slice(0, 20);
      return out;
    },
    excludeList() { return this.excludeListS || []; },
    // 排除应用两列拆分：前半左列、后半右列（框架的 flex-wrap 百分比宽度不可靠，手动分列）
    excludeCols() {
      var n = this.excludeList.length;
      var half = Math.ceil(n / 2);
      return [this.excludeList.slice(0, half), this.excludeList.slice(half)];
    },
    // P4 历史-明细聚合数据（detailS）：按键 kbd + 鼠标左/右/中归一化宽度
    detail() { return this.detailS || { kbd: [], kbdSum: 0, left: 0, right: 0, mid: 0, total: 0, distCm: 0, activeSec: 0, idleSec: 0, maxSessionSec: 0, sessionCount: 0 }; },
    // 明细时间范围按钮文案：全部时间显示数据覆盖范围，自定义显示起止
    detailRangeLabel() {
      if (this.detailAllTime) {
        return (this.storage.first && this.storage.last)
          ? (this.storage.first + ' ~ ' + this.storage.last) : '全部时间';
      }
      return this.detailStart + ' ~ ' + this.detailEnd;
    },
    // 历史控制条右侧单按钮文案：统计=柱状/折线，时段=月/周/日
    chartToggleLabel() {
      if (this.trendModeIdx == 0) return this.trendChartType == 'bar' ? '柱状' : '折线';
      if (this.trendModeIdx == 2) return this.heatScope == 2 ? '月' : (this.heatScope == 1 ? '周' : '日');
      return '';
    },
    // 日历网格（周一为首列，6 行 × 7 列；d=0 表示空白格；dis=无数据日期禁用）
    calWeeks() {
      var y = this.calY, m = this.calM;
      var first = new Date(y, m - 1, 1);
      var offset = (first.getDay() + 6) % 7;
      var dim = new Date(y, m, 0).getDate();
      var selD = 0;
      var p = String(this.dateStr).split('-');
      if (p.length >= 3 && parseInt(p[0]) == y && parseInt(p[1]) == m) selD = parseInt(p[2]);
      // 数据覆盖范围 [first, last]：范围外的日期无记录，禁用不可选
      var key = function (yy, mm, dd) { return yy * 10000 + mm * 100 + dd; };
      var parse = function (s) {
        var q = String(s || '').split('-');
        if (q.length >= 3) return { y: parseInt(q[0]) || 0, m: parseInt(q[1]) || 0, d: parseInt(q[2]) || 0 };
        return null;
      };
      var st = parse(this.storage.first), en = parse(this.storage.last);
      var fk = st ? key(st.y, st.m, st.d) : 0, lk = en ? key(en.y, en.m, en.d) : 0;
      var cells = [];
      for (var i = 0; i < offset; ++i) cells.push({ d: 0, sel: false, dis: true });
      for (var d = 1; d <= dim; ++d) {
        var k = key(y, m, d);
        cells.push({ d: d, sel: d == selD, dis: !(fk && lk && k >= fk && k <= lk) });
      }
      while (cells.length % 7 != 0) cells.push({ d: 0, sel: false, dis: true });
      var rows = [];
      for (var i = 0; i < cells.length; i += 7) rows.push(cells.slice(i, i + 7));
      return rows;
    },
    // 月选择网格（3 行 × 4 列；dis=无数据的月禁用）
    monthRows() {
      var pm = String(this.monthStr).split('-');
      var selY = parseInt(pm[0]) || 0, selM = parseInt(pm[1]) || 0;
      var parse = function (s) {
        var q = String(s || '').split('-');
        if (q.length >= 2) return { y: parseInt(q[0]) || 0, m: parseInt(q[1]) || 0 };
        return null;
      };
      var st = parse(this.storage.first), en = parse(this.storage.last);
      var fk = st ? st.y * 12 + (st.m - 1) : 0, lk = en ? en.y * 12 + (en.m - 1) : 0;
      var rows = [];
      for (var r = 0; r < 3; ++r) {
        var row = [];
        for (var c = 0; c < 4; ++c) {
          var m = r * 4 + c + 1;
          var mk = this.calY * 12 + (m - 1);
          row.push({ m: m, sel: this.calY == selY && m == selM, dis: !(fk && lk && mk >= fk && mk <= lk) });
        }
        rows.push(row);
      }
      return rows;
    }
  },
  methods: {
    go(v) { this.activeView = v; },
    setMode(i) { this.trendModeIdx = i; },
    toggleSeries(i) {
      var next = this.trendSeries.slice();
      next[i] = next[i] ? 0 : 1;
      // 与总览一致：四键至少生效一个，取消最后一个时忽略本次取消
      if (!(next[0] || next[1] || next[2] || next[3])) next[i] = 1;
      this.trendSeries = next;
    },
    // 图表类型切换：仅 日/月/年 缩放图生效
    setChartType(t) { this.trendChartType = t; },
    toggleOverviewSeries(i) {
      var next = this.overviewSeries.slice();
      next[i] = next[i] ? 0 : 1;
      // 四键至少生效一个：取消最后一个时忽略本次取消（勾选框自切换后需重新写回真值）
      if (!(next[0] || next[1] || next[2] || next[3])) next[i] = 1;
      this.overviewSeries = next;
    },
    // ---- 日期便携步进 ----
    pad2(n) { return (n < 10 ? '0' : '') + n; },
    // 周一（周模式选中范围的起始日）
    mondayYMD(y, m, d) {
      var dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() - ((dt.getDay() + 6) % 7));
      return dt.getFullYear() + '-' + this.pad2(dt.getMonth() + 1) + '-' + this.pad2(dt.getDate());
    },
    stepDate(mode, n) {   // mode: 0=日 ±n天, 4=本周时段 ±n天(±7)
      var target = (mode == 4) ? this.weekStr : this.dateStr;
      var p = String(target || '').split('-');
      var dt = new Date(parseInt(p[0]) || 2000, (parseInt(p[1]) || 1) - 1, (parseInt(p[2]) || 1) + n);
      var s = dt.getFullYear() + '-' + this.pad2(dt.getMonth() + 1) + '-' + this.pad2(dt.getDate());
      // 钳制到数据覆盖范围：不允许步进到无数据的日期
      var key = dt.getFullYear() * 10000 + (dt.getMonth() + 1) * 100 + dt.getDate();
      var st = this.parseD(this.storage.first), en = this.parseD(this.storage.last);
      var fk = st ? st.y * 10000 + st.m * 100 + st.d : 0;
      var lk = en ? en.y * 10000 + en.m * 100 + en.d : 0;
      if (fk && key < fk) s = this.storage.first;
      else if (lk && key > lk) s = this.storage.last;
      if (mode == 4) this.weekStr = s; else this.dateStr = s;
    },
    stepMonth(n) {
      var p = String(this.monthStr || '').split('-');
      var dt = new Date(parseInt(p[0]) || 2000, (parseInt(p[1]) || 1) - 1 + n, 1);
      var y = dt.getFullYear(), m = dt.getMonth() + 1;
      // 钳制到数据覆盖的月份范围：不允许步进到无数据的月
      var st = this.parseD(this.storage.first), en = this.parseD(this.storage.last);
      var fk = st ? st.y * 12 + (st.m - 1) : 0, lk = en ? en.y * 12 + (en.m - 1) : 0;
      var mk = y * 12 + (m - 1);
      if (fk && mk < fk) { y = st.y; m = st.m; }
      else if (lk && mk > lk) { y = en.y; m = en.m; }
      this.monthStr = y + '-' + this.pad2(m);
    },
    togglePause() { this.pauseCmd = this.pauseCmd + 1; },
    toggleAutostart() { this.autostartCmd = this.autostartCmd + 1; },
    toggleTheme() { this.themeCmd = this.themeCmd + 1; },
    // ---- 按应用筛选----
    openFilterPick() { this.filterPickOpen = true; },
    closeFilterPick() { this.filterPickOpen = false; },
    // name 为 '' 表示「全部应用」；写入 filterApp 并递增命令，C++ 轮询切换筛选
    setFilterApp(name) { this.filterApp = name || ''; this.filterAppCmd++; this.filterPickOpen = false; },
    // 悬停应用：写入 hoverApp 并递增命令，C++ 轮询后右侧趋势图切换为该应用。
    // 带去重：@mousemove 每像素触发，仅在悬停目标变化时才递增命令，避免高频重复轮询。
    setHoverApp(name) {
      name = name || '';
      if (this.hoverApp === name) return;
      this.hoverApp = name;
      this.hoverAppCmd++;
    },
    // 点选应用：固定显示（再次点选取消固定）
    togglePinApp(name) {
      this.pinnedApp = (this.pinnedApp === name) ? '' : name;
      this.pinnedAppCmd++;
    },
    applyExcl() { this.exclCmd++; },
    removeExcl(i) { this.removeExclName = this.excludeList[i]; this.removeExclCmd++; },
    // 两列分列后换算回 excludeList 原始下标（前半左列、后半右列）
    exclRealIndex(ci, ei) {
      var half = Math.ceil(this.excludeList.length / 2);
      return ci === 0 ? ei : half + ei;
    },
    exportData() { this.exportCmd = this.exportCmd + 1; },
    importData() { this.importCmd = this.importCmd + 1; },
    clearData() { this.initRangeFields(); this.clearCmd = this.clearCmd + 1; },
    exportCSV() { this.initRangeFields(); this.exportCsvCmd = this.exportCsvCmd + 1; },
    exportJSON() { this.initRangeFields(); this.exportJsonCmd = this.exportJsonCmd + 1; },
    // 打开范围弹窗前按数据实际覆盖范围（或今天）预填起始/结束
    initRangeFields() {
      var parse = function (s) {
        var p = String(s || '').split('-');
        if (p.length >= 3) return { y: parseInt(p[0]) || 0, m: parseInt(p[1]) || 0, d: parseInt(p[2]) || 0 };
        return null;
      };
      var st = parse(this.storage.first);
      var en = parse(this.storage.last);
      var now = new Date();
      if (!st) st = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
      if (!en) en = st;
      this.rangeStartY = st.y; this.rangeStartM = st.m; this.rangeStartD = st.d;
      this.rangeEndY = en.y; this.rangeEndM = en.m; this.rangeEndD = en.d;
    },
    ymdStr(y, m, d) {
      if (!y || !m || !d) return '';
      return y + '-' + this.pad2(m) + '-' + this.pad2(d);
    },
    // 某年月 的天数上限（用于日字段动态 max，联动闰年与月）
    daysInMonth(y, m) {
      if (!y || !m) return 31;
      return new Date(y, m, 0).getDate();
    },
    clampDayTo(y, m, d) {
      var mx = this.daysInMonth(y, m);
      return (d < 1 || d > mx) ? mx : d;
    },
    confirmRange() {
      // 提交前把日字段钳回当月真实天数，避免用户键入 31 日但选到 2 月时越界
      this.rangeStartD = this.clampDayTo(this.rangeStartY, this.rangeStartM, this.rangeStartD);
      this.rangeEndD   = this.clampDayTo(this.rangeEndY,   this.rangeEndM,   this.rangeEndD);
      this.rangeStart = this.ymdStr(this.rangeStartY, this.rangeStartM, this.rangeStartD);
      this.rangeEnd = this.ymdStr(this.rangeEndY, this.rangeEndM, this.rangeEndD);
      this.rangePickCmd = this.rangePickCmd + 1;
    },
    // 快捷选择（Q10 确认）：今日 / 本周 / 本月 / 全部历史。全部写入范围字段。
    rangeToday() {
      var now = new Date();
      var y = now.getFullYear(), m = now.getMonth() + 1, d = now.getDate();
      this.rangeStartY = y; this.rangeStartM = m; this.rangeStartD = d;
      this.rangeEndY   = y; this.rangeEndM   = m; this.rangeEndD   = d;
    },
    rangeWeek() {
      var now = new Date();
      // 周一为首日：weekday 0=Sun..6=Sat → (wd+6)%7 = 0..6 表示距本周一的天数
      var wd = (now.getDay() + 6) % 7;
      var start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - wd);
      var end   = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 6 - wd);
      this.rangeStartY = start.getFullYear(); this.rangeStartM = start.getMonth() + 1; this.rangeStartD = start.getDate();
      this.rangeEndY   = end.getFullYear();   this.rangeEndM   = end.getMonth() + 1;   this.rangeEndD   = end.getDate();
    },
    rangeMonth() {
      var now = new Date();
      var y = now.getFullYear(), m = now.getMonth() + 1;
      var dim = this.daysInMonth(y, m);
      this.rangeStartY = y; this.rangeStartM = m; this.rangeStartD = 1;
      this.rangeEndY   = y; this.rangeEndM   = m; this.rangeEndD   = dim;
    },
    // 全部历史 = 恢复为完整数据范围（最早 ~ 最晚），而不是归零
    rangeAll() { this.initRangeFields(); },
    cancelRange() { this.rangeCancelCmd = this.rangeCancelCmd + 1; this.rangePickOpen = false; },
    // ---- 明细时间范围快捷：今日/本周/本月/全部，与导出弹窗一致的语义，起止含 时:分 ----
    setDetailFields(sy, sm, sd, ey, em, ed) {
      this.detailStartY = sy; this.detailStartM = sm; this.detailStartD = sd; this.detailStartH = 0; this.detailStartN = 0;
      this.detailEndY = ey; this.detailEndM = em; this.detailEndD = ed; this.detailEndH = 23; this.detailEndN = 59;
    },
    rangeTodayDetail() {
      var now = new Date();
      this.setDetailFields(now.getFullYear(), now.getMonth() + 1, now.getDate(),
                           now.getFullYear(), now.getMonth() + 1, now.getDate());
    },
    rangeWeekDetail() {
      var now = new Date();
      var wd = (now.getDay() + 6) % 7;
      var s = new Date(now.getFullYear(), now.getMonth(), now.getDate() - wd);
      var e = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 6 - wd);
      this.setDetailFields(s.getFullYear(), s.getMonth() + 1, s.getDate(),
                           e.getFullYear(), e.getMonth() + 1, e.getDate());
    },
    rangeMonthDetail() {
      var now = new Date();
      var y = now.getFullYear(), m = now.getMonth() + 1;
      this.setDetailFields(y, m, 1, y, m, this.daysInMonth(y, m));
    },
    rangeAllDetail() {
      var st = this.parseD(this.storage.first);
      var en = this.parseD(this.storage.last);
      var now = new Date();
      if (!st) st = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
      if (!en) en = st;
      this.setDetailFields(st.y, st.m, st.d, en.y, en.m, en.d);
    },
    // ---- 明细时间范围：全部时间 ⇄ 弹窗选范围 ----
    openDetailRange() {
      var st = this.parseD(this.storage.first);
      var en = this.parseD(this.storage.last);
      var now = new Date();
      if (!st) st = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
      if (!en) en = st;
      this.detailStartY = st.y; this.detailStartM = st.m; this.detailStartD = st.d; this.detailStartH = 0; this.detailStartN = 0;
      this.detailEndY = en.y; this.detailEndM = en.m; this.detailEndD = en.d; this.detailEndH = 23; this.detailEndN = 59;
      this.detailRangeOpen = true;
    },
    parseD(s) {
      var p = String(s || '').split('-');
      if (p.length >= 3) return { y: parseInt(p[0]) || 0, m: parseInt(p[1]) || 0, d: parseInt(p[2]) || 0 };
      return null;
    },
    confirmDetailRange() {
      var pad2 = function (n) { return (n < 10 ? '0' : '') + n; };
      var clamp = function (y, m, d) {
        var mx = this.daysInMonth(y, m);
        return (d < 1 || d > mx) ? mx : d;
      }.bind(this);
      // 起止全未填（字段全 0）：回落为"全部时间"，不产生无效范围
      if (!this.detailStartY && !this.detailEndY) {
        this.detailAllTime = true;
        this.detailStart = ''; this.detailEnd = '';
        this.detailRangeOpen = false;
        return;
      }
      this.detailStartD = clamp(this.detailStartY, this.detailStartM, this.detailStartD);
      this.detailEndD = clamp(this.detailEndY, this.detailEndM, this.detailEndD);
      this.detailStart = this.detailStartY + '-' + pad2(this.detailStartM) + '-' + pad2(this.detailStartD) +
        ' ' + pad2(this.detailStartH || 0) + ':' + pad2(this.detailStartN || 0);
      this.detailEnd = this.detailEndY + '-' + pad2(this.detailEndM) + '-' + pad2(this.detailEndD) +
        ' ' + pad2(this.detailEndH || 0) + ':' + pad2(this.detailEndN || 0);
      this.detailAllTime = false;
      this.detailRangeCmd = this.detailRangeCmd + 1;
      this.detailRangeOpen = false;
    },
    cancelDetailRange() {
      this.detailRangeCancelCmd = this.detailRangeCancelCmd + 1;
      // 取消 = 回落到"全部时间"（与移除"全部时间"按钮后的语义一致）
      this.detailAllTime = true;
      this.detailRangeOpen = false;
    },
    openLink(u) { this.linkUrl = u; this.linkCmd++; },
    fmt(v) {
      if (v == null || v === '') return '0';
      // 默认显示准确值；窗口过窄（compact 由 C++ resize 回调同步）时才缩写
      if (!this.compact) return String(v);
      if (v >= 1000000000) return (v / 1000000000).toFixed(1) + 'B';
      if (v >= 1000000) return (v / 1000000).toFixed(1) + 'M';
      if (v >= 1000) return (v / 1000).toFixed(1) + 'K';
      return String(v);
    },
    fmtMin(sec) {
      // 累计活跃时间显示为“一位小数小时”格式，单位缩写为 h
      var h = (sec || 0) / 3600;
      return h.toFixed(1) + 'h';
    },
    // 里程（厘米）→ 可读距离：km / m / cm
    fmtDist(cm) {
      var c = cm || 0;
      if (c >= 100000) return (c / 100000).toFixed(2) + ' km';
      if (c >= 1000) return (c / 100).toFixed(1) + ' m';
      return c + ' cm';
    },
    // 字节数 → 可读大小（B / KB / MB）
    fmtBytes(b) {
      var n = b || 0;
      if (n >= 1048576) return (n / 1048576).toFixed(2) + ' MB';
      if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
      return n + ' B';
    },
    // ---- 日期选择弹窗 ----
    openCal() {
      var now = new Date();
      if (this.trendModeIdx == 2) {
        if (this.heatScope == 2) {   // 时段-月：年 + 12 月
          var p = String(this.monthStr).split('-');
          this.calY = parseInt(p[0]) || now.getFullYear();
        } else {                     // 时段-日/周：月历选日
          var target = this.heatScope == 1 ? this.weekStr : this.dateStr;
          var p = String(target).split('-');
          this.calY = parseInt(p[0]) || now.getFullYear();
          this.calM = parseInt(p[1]) || (now.getMonth() + 1);
        }
      } else {                       // 统计表：月历选日
        var p = String(this.dateStr).split('-');
        this.calY = parseInt(p[0]) || now.getFullYear();
        this.calM = parseInt(p[1]) || (now.getMonth() + 1);
      }
      this.calOpen = true;
    },
    closeCal() { this.calOpen = false; },
    calShift(n) { // n = 月数（±1 月，±12 年）
      var m = this.calM + n, y = this.calY;
      while (m > 12) { m -= 12; y += 1; }
      while (m < 1) { m += 12; y -= 1; }
      this.calY = y;
      this.calM = m;
    },
    pickDay(d) {
      if (d <= 0) return;
      if (this.trendModeIdx == 2 && this.heatScope == 1) {
        this.weekStr = this.mondayYMD(this.calY, this.calM, d);   // 时段-周：选中日所在周（周一）
      } else {
        this.dateStr = this.calY + '-' + this.pad2(this.calM) + '-' + this.pad2(d);
      }
      this.closeCal();
    },
    pickMonth(m) {
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      this.monthStr = this.calY + '-' + pad(m);
      this.closeCal();
    },
    // ---- 时段 scope 与步进 ----
    setHeatScope(s) { this.heatScope = s; },
    // 历史控制条右侧单按钮：统计=柱状/折线，时段=月/周/日 循环
    toggleChartCycle() {
      if (this.trendModeIdx == 0) {
        this.setChartType(this.trendChartType == 'bar' ? 'line' : 'bar');
      } else if (this.trendModeIdx == 2) {
        this.setHeatScope(this.heatScope == 2 ? 1 : (this.heatScope == 1 ? 0 : 2));
      }
    },
    heatStep(n) {   // n = ±1 步（日=±1 天，周=±1 周，月=±1 月）
      if (this.heatScope == 2) this.stepMonth(n);
      else if (this.heatScope == 1) this.stepDate(4, n * 7);
      else this.stepDate(0, n);
    },
    onModalBgClick() { this.closeCal(); },
    onCardClick() { },
    onModalKeydown() { this.closeCal(); }
  }
}
</script>

<style>
  /* 颜色统一走库主题令牌（var(--...)），深浅主题切换由 C++ 侧 ui_theme_set_mode 驱动 */
  .app { width: 100%; height: 100%; flex-direction: column; background: var(--window-bg); }

  .nav { flex-direction: row; align-items: center; gap: 4px;
         padding: 0 14px; height: 52px; background: var(--card-bg);
         box-shadow: 0 1px 0 var(--border-subtle); }
  .navtab { padding: 6px 14px; border-radius: 8px; color: var(--fg-2);
            font-size: 13px; cursor: pointer; background: transparent; }
  .navtab:hover { background: var(--bg-3); }
  .navtab.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .spacer { flex-grow: 1; }
  /* 右侧方形按钮：主题切换（与导航标签风格一致） */
  .circle-btn { width: 40px; padding: 6px 0; border-radius: 8px; font-size: 13px;
                cursor: pointer; border: none; flex: none;
                display: flex; align-items: center; justify-content: center;
                background: var(--bg-3); color: var(--fg-2); }
  /* 采集状态按钮：文案（采集中/已暂停）自适应宽度 */
  .state-btn { min-width: 62px; padding: 6px 12px; border-radius: 8px; font-size: 13px;
               font-weight: 600; cursor: pointer; border: none; flex: none;
               display: flex; align-items: center; justify-content: center;
               background: var(--bg-3); color: var(--fg-2); }
  .st-run { background: #1f9d55; color: #ffffff; }        /* 采集中：绿 */
  .st-paused { background: #d97706; color: #ffffff; }     /* 已暂停：橙 */
  .st-theme-light { background: #f59e0b; color: #ffffff; } /* 当前浅色：琥珀 */
  .st-theme-dark { background: #475569; color: #f1f5f9; } /* 当前深色：石板 */

  .content { flex-grow: 1; width: 100%; height: 0; overflow: hidden; }
  .view { width: 100%; height: 100%; padding: 12px; gap: 12px; flex-direction: column; overflow: hidden; }

  /* 总览：7 项 KPI 分两行（4 + 3，末尾占位保持等宽） */
  .kpiwrap { flex-direction: column; gap: 10px; }
  .kpis { flex-direction: row; gap: 10px; }
  .kpi2 { flex-grow: 1; background: var(--card-bg); border-radius: 8px;
          padding: 10px 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);
          flex-direction: row; align-items: center; justify-content: space-between; }
  .kpi2 .t { font-size: 12px; color: var(--fg-3); }
  .kpi2 .v { font-size: 17px; font-weight: 600; color: #4d9fff; }

  .section { background: var(--card-bg); border-radius: 10px; padding: 16px 18px;
             box-shadow: 0 1px 2px rgba(0,0,0,0.04); flex-direction: column; overflow: hidden;
             contain: layout style; }
  .section-title { font-size: 12px; font-weight: 600; color: var(--fg-3); text-align: center;
                   margin-bottom: 2px; }
  .flush { flex: 1 1 auto; min-height: 0; height: 0; }

  .kbd-table { width: 100%; flex-direction: column; gap: 2px; }
  .kt-row { flex-direction: row; align-items: center; padding: 6px 10px;
            border-radius: 6px; }
  .kt-row:hover { background: var(--bg-3); }
  .kt-label { font-size: 13px; color: var(--fg-2); width: 128px; flex: none; white-space: nowrap; }
  /* 原生 progressbar：内部按 value/(max-min) 比例填充，:value 绑定真实反应式更新 */
  .kt-bar { flex-grow: 1; height: 8px; }
  .kt-count { width: 68px; text-align: right; font-size: 13px; color: var(--fg); font-weight: 600; flex: none; }
  /* 24h 应用行悬停高亮 + 点选固定 + 展开详情 */
  .ap-row { border-radius: 6px; }
  .ap-row:hover { background: var(--bg-2); }
  .ap-row.on { background: var(--bg-2); }
  .ap-detail { display: none; flex-direction: row; justify-content: flex-start; padding: 2px 6px 4px 6px; gap: 2px; }
  .ap-row:hover .ap-detail { display: flex; }

  .mouse-grid { flex-direction: column; gap: 8px; }
  .mouse-col { flex: 1; flex-direction: column; gap: 4px; }
  .mouse-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 7px 10px;
               border-radius: 6px; }
  .mouse-row:hover { background: var(--bg-3); }
  .mouse-row2 { flex-direction: row; align-items: center; justify-content: space-between; padding: 6px 10px;
                border-radius: 6px; }
  .mouse-row2:hover { background: var(--bg-3); }
  .mouse-name { font-size: 13px; color: var(--fg-2); width: 56px; flex: none; }
  .mouse-name2 { font-size: 13px; color: var(--fg-2); flex: none; }
  .mouse-bar { flex-grow: 1; height: 8px; }
  .mouse-val { width: 72px; text-align: right; font-size: 13px; color: var(--fg); font-weight: 600; flex: none; }
  .mouse-val2 { text-align: right; font-size: 13px; color: var(--accent); font-weight: 600; }

  .canvas { flex-grow: 1; width: 100%; min-height: 0; }
  .scroll-fill { flex: 1 1 auto; width: 100%; min-height: 0; height: 0; overflow-y: auto; overflow-x: hidden; }

  .modes { flex-direction: row; gap: 6px; align-items: center; }
  /* 主按钮（统计/时段/明细）用 .mode；控制条内次级控件用更紧凑的 .mode-s */
  .mode { padding: 5px 12px; border-radius: 7px; font-size: 12px; color: var(--fg-2);
          cursor: pointer; background: var(--bg-3); }
  .mode.on { background: var(--accent); color: var(--fg-on-accent); }
  .mode-s { padding: 2px 16px; border-radius: 6px; font-size: 11px; color: var(--fg-2);
            cursor: pointer; background: var(--bg-3); line-height: 1.2; }
  .mode-s.on { background: var(--accent); color: var(--fg-on-accent); }
  .ctrlbar { flex-direction: row; align-items: center; gap: 8px; width: 100%; }
  /* 应用筛选：弹窗选项按钮 + 入口按钮选中态 */
  .filter-opt { width: 100%; padding: 8px 12px; border-radius: 6px; font-size: 12px;
                cursor: pointer; background: transparent; color: var(--fg-2);
                text-align: left; white-space: nowrap; overflow: hidden; flex: none; }
  .filter-opt:hover { background: var(--bg-3); }
  .filter-opt.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .calbtn.on { background: var(--accent); color: var(--fg-on-accent); }

  .tinput { background: var(--input-bg); border: 1px solid var(--input-border);
            border-radius: 6px; padding: 5px 10px; font-size: 12px; color: var(--fg);
            width: 118px; }
  .calbtn { padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;
            background: var(--bg-3); color: var(--fg-2); }
  /* 日期显示按钮（统计表 / 时段的当前日期，点击打开日历；与 .calbtn 同风格） */
  .datebtn { padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;
             background: var(--bg-3); color: var(--fg-2); white-space: nowrap; }
  .datebtn:hover { background: var(--bg-2); color: var(--fg); }
  /* 日期便携步进调整：文本框两侧 ‹ › */
  .datebox { flex-direction: row; align-items: center; gap: 4px; }
  .stepper { width: 24px; height: 26px; border-radius: 6px; font-size: 14px; cursor: pointer;
             background: var(--bg-3); color: var(--fg-2); text-align: center;
             display: flex; align-items: center; justify-content: center; padding: 0; }
  .stepper:hover { background: var(--bg-2); color: var(--fg); }

  /* 日期选择弹窗（覆盖全窗口，点击遮罩关闭） */
  .modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
           background: rgba(0,0,0,0.35); flex-direction: row;
           justify-content: center; align-items: center; }
  .calcard { background: var(--card-bg); border-radius: 10px; padding: 14px;
             box-shadow: 0 10px 30px rgba(0,0,0,0.30); }
  .calhead { flex-direction: row; align-items: center; gap: 6px; margin-bottom: 8px; }
  .caltitle { flex-grow: 1; text-align: center; font-size: 13px; color: var(--fg);
              font-weight: 600; }
  .navarrow { width: 28px; height: 28px; border-radius: 6px; font-size: 14px; cursor: pointer;
              background: var(--bg-3); color: var(--fg-2); text-align: center;
              display: flex; align-items: center; justify-content: center; padding: 0; }
  .cal-row { flex-direction: row; gap: 4px; margin-bottom: 4px; }
  .cal-wd { width: 34px; text-align: center; font-size: 11px; color: var(--fg-3); }
  .cal-day { width: 34px; height: 30px; text-align: center; font-size: 12px;
             color: var(--fg); background: var(--bg-3); border-radius: 6px; cursor: pointer; }
  .cal-day.blank { background: transparent; cursor: default; }
  .cal-day.sel { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .cal-day.dis { color: var(--fg-3); background: var(--bg-2); cursor: default; opacity: 0.55; }
  .cal-cell { width: 64px; height: 32px; text-align: center; font-size: 12px;
              color: var(--fg); background: var(--bg-3); border-radius: 6px; cursor: pointer; }
  .cal-cell.sel { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .cal-cell.dis { color: var(--fg-3); background: var(--bg-2); cursor: default; opacity: 0.55; }

  /* 范围选择弹窗（导出 CSV/JSON、清除数据的日期范围） */
  .rng-modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
               background: rgba(0,0,0,0.35); flex-direction: row;
               justify-content: center; align-items: center; }
  .rng-card { background: var(--card-bg); border-radius: 10px; padding: 16px;
              box-shadow: 0 10px 30px rgba(0,0,0,0.30); width: 480px;
              flex-direction: column; gap: 10px; }
  .rng-title { font-size: 14px; font-weight: 600; color: var(--fg); }
  .rng-hint { font-size: 12px; color: var(--fg-3); }
  .rng-row { flex-direction: row; align-items: center; gap: 8px; }
  .rng-label { font-size: 12px; color: var(--fg-2); width: 42px; flex: none; }
  .rng-input { background: var(--input-bg); border: 1px solid var(--input-border);
               border-radius: 6px; padding: 5px 8px; font-size: 12px; color: var(--fg);
               flex-grow: 1; }
  /* 年月日三组可调节：number 输入自带步进，仅并排 + 单位（再加宽一倍保证数字完整显示） */
  .rng-date3 { flex-direction: row; align-items: center; gap: 4px; flex-grow: 1; }
  .rng-input.num { width: 128px; flex: none; text-align: center; padding: 4px 2px; }
  .rng-input.num.sm { width: 96px; }
  /* 明细弹窗：5 框并排（年/月/日/时/分），收窄输入宽度；年框加宽 */
  .rng-input.num.tn { width: 56px; }
  .rng-input.num.tn.y { width: 80px; }
  .rng-unit { font-size: 11px; color: var(--fg-3); width: 14px; text-align: center; flex: none; }
  .rng-actions { flex-direction: row; align-items: center; gap: 8px; margin-top: 4px; }
  .rng-btn { padding: 6px 14px; border-radius: 6px; font-size: 12px; cursor: pointer;
             background: var(--bg-3); color: var(--fg-2); flex: none; white-space: nowrap; }
  .rng-btn.on { background: var(--accent); color: var(--fg-on-accent); }
  .rng-btn.danger { background: #b42318; color: #ffffff; }

  /* 关于页 */
  .ab-title { font-size: 18px; font-weight: 600; color: var(--fg); margin-bottom: 8px; }
  .ab-h2 { font-size: 13px; font-weight: 600; color: var(--fg); margin-bottom: 6px; margin-top: 12px; }
  .ab-line { font-size: 12px; color: var(--fg-2); margin-bottom: 3px; line-height: 1.5; }
  .ab-btns { flex-direction: row; gap: 10px; margin: 4px 0; }
  .ab-btn { padding: 8px 12px; border-radius: 8px; font-size: 13px; cursor: pointer;
          background: var(--accent); color: var(--fg-on-accent);
          flex: none; white-space: nowrap; width: 112px; }
  .ab-btn.ghost { background: var(--bg-3); color: var(--fg-2); }
  .ab-btn.danger { background: #b42318; color: #ffffff; }
  .ab-btns.data .ab-btn { width: 80px; padding: 8px 8px; }
  /* 配列切换按钮（108/87/61） */
  .laybtn { padding: 8px 12px; border-radius: 8px; font-size: 13px; cursor: pointer;
            background: var(--bg-3); color: var(--fg-2);
            flex: none; white-space: nowrap; width: 68px; }
  .laybtn.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .ab-link { padding: 6px 10px; border-radius: 8px; font-size: 12px; cursor: pointer;
            background: var(--bg-3); color: #4d9fff;
            flex: none; white-space: nowrap; width: 118px; text-align: center; }
  .ab-link:hover { background: var(--accent); color: var(--fg-on-accent); }
  .ab-section { background: var(--bg-2); border-radius: 8px; padding: 10px 14px; margin-bottom: 8px; }
</style>

<template>
  <div class="app">
    <div class="nav">
      <button v-for="(t, i) in tabs" :key="t.id"
              :class="activeView == t.id ? 'navtab on' : 'navtab'"
              @click="go(t.id)">{{ t.label }}</button>
      <div class="spacer"></div>
      <button class="state-btn" :class="paused ? 'st-paused' : 'st-run'" @click="togglePause"
              :title="paused ? '点击恢复采集' : '点击暂停采集'">
        {{ paused ? '已暂停' : '采集中' }}
      </button>
      <button class="circle-btn" :class="dark ? 'st-theme-dark' : 'st-theme-light'" @click="toggleTheme"
              :title="dark ? '切换浅色' : '切换深色'">
        {{ dark ? '☀' : '🌙' }}
      </button>
    </div>

    <div class="content">
      <!-- 总览：KPI 卡片 + 活跃/空闲 + 里程碑 + 活跃应用 -->
      <div v-if="activeView == 'overview'" class="view">
        <div class="kpiwrap">
          <div class="kpis">
            <div class="kpi2"><label class="t">今日按键</label><label class="v">{{ fmt(today.keys) }}</label></div>
            <div class="kpi2"><label class="t">今日点击</label><label class="v">{{ fmt(today.clicks) }}</label></div>
            <div class="kpi2"><label class="t">今日里程</label><label class="v">{{ fmtDist(today.distCm) }}</label></div>
            <div class="kpi2"><label class="t">今日活跃</label><label class="v">{{ fmtMin(today.activeSec) }}</label></div>
          </div>
          <div class="kpis">
            <div class="kpi2"><label class="t">累计按键</label><label class="v">{{ fmt(total.keys) }}</label></div>
            <div class="kpi2"><label class="t">累计点击</label><label class="v">{{ fmt(total.clicks) }}</label></div>
            <div class="kpi2"><label class="t">累计里程</label><label class="v">{{ fmtDist(total.distCm) }}</label></div>
            <div class="kpi2"><label class="t">累计活跃</label><label class="v">{{ fmtMin(total.activeSec) }}</label></div>
          </div>
        </div>
        <div class="section flush" style="flex-direction: row; gap: 10px; padding: 0; background: transparent; box-shadow: none; margin-top: -2px;">
          <!-- 24h 应用活动占比（左侧；与上方单个 KPI 列等宽） -->
          <div v-if="optAppTrack && apps24h.length" class="section" style="flex:1; min-width: 0; padding: 10px 12px; flex-direction: column;">
            <label class="section-title">24h应用活跃排行</label>
            <ScrollView auto-hide-scrollbar="true" style="flex-grow: 1; height: 0; margin-top: 6px;"
                        @mouseleave="setHoverApp('')">
              <div v-for="(a, ai) in apps24h" :key="ai" class="ap-row"
                   :class="pinnedApp == a.n ? 'on' : ''"
                   style="flex-direction: column; flex: none; padding: 2px 6px;"
                   @mouseenter="setHoverApp(a.n)" @click="togglePinApp(a.n)">
                <!-- 行1：进程名（随窗口自适应，过长省略） -->
                <label style="font-size: 12px; color: var(--fg); white-space: nowrap; overflow: hidden;" :title="a.n">{{ a.n }}</label>
                <!-- 行2：进度条 + 评分 -->
                <div style="flex-direction: row; align-items: center; gap: 6px; height: 14px;">
                  <progressbar class="kt-bar" style="flex-grow: 1; height: 6px;" min="0" max="100" :value="a.s"></progressbar>
                  <label style="flex: none; font-size: 11px; color: var(--fg-2); width: 34px; text-align: right;">{{ a.s }}</label>
                </div>
                <!-- 行3：hover 展开详情（按键/点击/里程/活跃） -->
                <div class="ap-detail">
                  <label style="font-size: 10px; color: var(--fg-2); white-space: nowrap;">按 {{ fmt(a.k) }} · 点 {{ fmt(a.cl) }} · {{ fmtDist(a.m) }} · 活跃 {{ fmtMin(a.a * 60) }}</label>
                </div>
              </div>
              <div style="height: 20px; flex: none;"></div>
            </ScrollView>
          </div>
          <!-- 24h 键鼠活动趋势（右侧；flex:3 = 上方 3 列 KPI 宽度和） -->
          <div class="section" style="flex:3; padding: 10px 12px; flex-direction: column;">
            <div style="flex-direction: row; align-items: center; gap: 8px; margin-bottom: 2px;">
              <label class="section-title" style="flex: none;">24h活动趋势</label>
              <div style="flex-grow: 1;"></div>
              <button class="mode-s" :class="overviewSeries[0] ? 'on' : ''" @click="toggleOverviewSeries(0)">按键</button>
              <button class="mode-s" :class="overviewSeries[1] ? 'on' : ''" @click="toggleOverviewSeries(1)">点击</button>
              <button class="mode-s" :class="overviewSeries[2] ? 'on' : ''" @click="toggleOverviewSeries(2)">里程</button>
              <button class="mode-s" :class="overviewSeries[3] ? 'on' : ''" @click="toggleOverviewSeries(3)">活跃</button>
            </div>
            <custom id="apm_canvas" class="canvas" style="margin-top: 2px;"></custom>
          </div>
        </div>
      </div>

      <!-- 热力：键盘/鼠标 合并（heatDev 切换 + 配列三按钮 R10 迁移 + 应用筛选合一） -->
      <div v-if="activeView == 'heat'" class="view" style="padding: 12px; gap: 12px;">
        <div class="modes" style="flex: none; width: 100%;">
          <button :class="heatDev == 0 ? 'mode on' : 'mode'" @click="heatDev = 0">键盘</button>
          <button :class="heatDev == 1 ? 'mode on' : 'mode'" @click="heatDev = 1">鼠标</button>
          <div style="flex-grow: 1;"></div>
          <!-- 配列按钮（仅键盘热力生效） -->
          <button v-show="heatDev == 0" class="laybtn" :class="kbLayout == 0 ? 'on' : ''" @click="kbLayout = 0">108键</button>
          <button v-show="heatDev == 0" class="laybtn" :class="kbLayout == 1 ? 'on' : ''" @click="kbLayout = 1">87键</button>
          <button v-show="heatDev == 0" class="laybtn" :class="kbLayout == 2 ? 'on' : ''" @click="kbLayout = 2">61键</button>
          <!-- 应用筛选按钮：始终贴最右 -->
          <button class="mode" :class="filterApp ? 'on' : ''"
                  @click="openFilterPick" style="max-width: 200px; white-space: nowrap; overflow: hidden; flex: none;"
                  :title="filterApp ? '应用筛选：' + filterApp : '应用筛选：全部应用'">{{ filterApp || '全部应用' }}</button>
        </div>
        <!-- 键盘热力图（custom id 不变，onKeyHeatMount 挂载回调依旧生效） -->
        <div class="section flush" v-if="heatDev == 0">
          <custom id="keyheat_canvas" class="canvas"></custom>
        </div>
        <!-- 鼠标热力图（custom id 不变，onMouseHeatMount 挂载回调依旧生效） -->
        <div class="section flush" v-if="heatDev == 1">
          <custom id="mouseheat_canvas" class="canvas"></custom>
        </div>
      </div>

      <!-- 历史：统计 / 时段 / 明细 三模式 -->
      <div v-if="activeView == 'trend'" class="view">
        <div class="ctrlbar" style="flex: none;">
          <!-- 左侧：模式 + 系列选择 -->
          <div class="modes" style="flex-shrink: 1; min-width: 0;">
            <button :class="trendModeIdx == 0 ? 'mode on' : 'mode'" @click="setMode(0)">统计</button>
            <button :class="trendModeIdx == 2 ? 'mode on' : 'mode'" @click="setMode(2)">时段</button>
            <button :class="trendModeIdx == 1 ? 'mode on' : 'mode'" @click="setMode(1)">明细</button>
          </div>
          <div v-show="trendModeIdx == 0" class="modes" style="flex: 1 1 auto; justify-content: center; min-width: 0;">
            <button class="mode-s" :class="trendSeries[0] ? 'on' : ''" @click="toggleSeries(0)">按键</button>
            <button class="mode-s" :class="trendSeries[1] ? 'on' : ''" @click="toggleSeries(1)">点击</button>
            <button class="mode-s" :class="trendSeries[2] ? 'on' : ''" @click="toggleSeries(2)">里程</button>
            <button class="mode-s" :class="trendSeries[3] ? 'on' : ''" @click="toggleSeries(3)">活跃</button>
          </div>
          <div v-show="trendModeIdx == 2" class="modes" style="flex: 1 1 auto; justify-content: center; min-width: 0;">
            <button class="mode-s" :class="heatSeries == 0 ? 'on' : ''" @click="heatSeries = 0">按键</button>
            <button class="mode-s" :class="heatSeries == 1 ? 'on' : ''" @click="heatSeries = 1">点击</button>
            <button class="mode-s" :class="heatSeries == 2 ? 'on' : ''" @click="heatSeries = 2">里程</button>
            <button class="mode-s" :class="heatSeries == 3 ? 'on' : ''" @click="heatSeries = 3">活跃</button>
          </div>
          <!-- 明细模式无系列按钮，用占位弹性撑开，把右侧时间/应用按钮推到最右 -->
          <div v-show="trendModeIdx == 1" style="flex-grow: 1; flex-shrink: 1;"></div>

          <!-- 右侧：状态切换 + 时间 + 应用（靠右对齐；v-show 避免挂载顺序错位） -->
          <button v-show="trendModeIdx != 1" class="mode-s" @click="toggleChartCycle">{{ chartToggleLabel }}</button>
          <div class="datebox" v-show="trendModeIdx == 0" style="flex-shrink: 1; min-width: 0;">
            <button class="stepper" @click="stepDate(0, -1)">‹</button>
            <button class="datebtn" @click="openCal">{{ dateStr }}</button>
            <button class="stepper" @click="stepDate(0, 1)">›</button>
          </div>
          <div class="datebox" v-show="trendModeIdx == 2" style="flex-shrink: 1; min-width: 0;">
            <button class="stepper" @click="heatStep(-1)">‹</button>
            <button class="datebtn" @click="openCal">{{ heatScope == 1 ? weekStr : (heatScope == 2 ? monthStr : dateStr) }}</button>
            <button class="stepper" @click="heatStep(1)">›</button>
          </div>
          <button v-show="trendModeIdx == 1" class="mode-s" @click="openDetailRange"
                  style="max-width: 206px; white-space: nowrap; overflow: hidden; flex-shrink: 1; min-width: 0;"
                  :title="detailRangeLabel">{{ detailRangeLabel }}</button>
          <button class="calbtn" :class="filterApp ? 'on' : ''"
                  @click="openFilterPick" style="max-width: 200px; white-space: nowrap; overflow: hidden; flex-shrink: 1; min-width: 0;"
                  :title="filterApp ? '按应用查看：' + filterApp : '按应用查看：全部应用'">{{ filterApp || '全部应用' }}</button>
        </div>

        <div class="section flush" style="padding: 0; background: transparent; box-shadow: none;">
          <div class="section" v-if="trendModeIdx != 1" style="flex: 1 1 auto; min-height: 0;">
            <custom id="trend_canvas" class="canvas"></custom>
          </div>

          <!-- 明细视图：上方鼠标窗格，下方键盘窗格 -->
          <div v-if="trendModeIdx == 1" style="flex: 1 1 auto; min-height: 0; flex-direction: column; gap: 10px;">
            <!-- 上方窗格：鼠标详情（左/中/右键 + 里程/活跃/最长连续活跃） -->
            <div class="section" style="flex: 0 0 auto; padding: 10px 12px; flex-direction: column;">
              <div style="flex-direction: row; gap: 16px;">
                <div class="mouse-col" style="flex: 1;">
                  <div class="mouse-row"><label class="mouse-name">左键</label>
                    <progressbar class="mouse-bar" min="0" max="100" :value="detail.leftW"></progressbar>
                    <label class="mouse-val">{{ fmt(detail.left) }}</label></div>
                  <div class="mouse-row"><label class="mouse-name">中键</label>
                    <progressbar class="mouse-bar" min="0" max="100" :value="detail.midW"></progressbar>
                    <label class="mouse-val">{{ fmt(detail.mid) }}</label></div>
                  <div class="mouse-row"><label class="mouse-name">右键</label>
                    <progressbar class="mouse-bar" min="0" max="100" :value="detail.rightW"></progressbar>
                    <label class="mouse-val">{{ fmt(detail.right) }}</label></div>
                </div>
                <div class="mouse-col" style="flex: 1;">
                  <div class="mouse-row2"><label class="mouse-name2">里程</label><label class="mouse-val2">{{ fmtDist(detail.distCm) }}</label></div>
                  <div class="mouse-row2"><label class="mouse-name2">活跃</label><label class="mouse-val2">{{ fmtMin(detail.activeSec) }}</label></div>
                  <div class="mouse-row2"><label class="mouse-name2">最长连续活跃</label><label class="mouse-val2">{{ fmtMin(detail.maxSessionSec) }}</label></div>
                </div>
              </div>
            </div>
            <!-- 下方窗格：键盘所有按键单列 -->
            <div class="section" style="flex: 1 1 0; min-height: 0; padding: 10px 12px; flex-direction: column;">
              <ScrollView class="scroll-fill" style="flex: 1 1 0; min-height: 0;">
                <div class="kbd-table">
                  <div v-for="(k, ki) in detail.kbd" :key="ki" class="kt-row">
                    <label class="kt-label">{{ k.l }}</label>
                    <progressbar class="kt-bar" min="0" max="100" :value="k.w"></progressbar>
                    <label class="kt-count">{{ fmt(k.c) }}</label>
                  </div>
                </div>
              </ScrollView>
            </div>
          </div>
        </div>
      </div>

      <!-- 设置（原 设置 + 关于 合并） -->
      <div v-if="activeView == 'settings'" class="view">
        <div class="section flush">
          <ScrollView class="scroll-fill">
            <div class="mouse-grid">
              <!-- 标题+版本+简介置顶（从页面中下部上移） -->
              <label class="ab-title" style="margin-top: 0;">键鼠使用记录 v3.1.0</label>
              <label class="ab-line" style="margin-bottom: 2px;">本地键盘 / 鼠标使用统计工具，统计按键、点击与移动次数。</label>

              <label class="ab-h2">存储</label>
              <div class="ab-section">
                <label class="ab-line" style="margin-top: 0;">当前存储：{{ fmtBytes(storage.bytes) }} · {{ storage.days }} 天（{{ storage.first || '—' }} ~ {{ storage.last || '—' }}）</label>
                <div class="ab-btns data" style="margin-top: 6px;">
                  <button class="ab-btn" @click="exportData">备份 .kmt</button>
                  <button class="ab-btn" @click="exportCSV">导出 CSV</button>
                  <button class="ab-btn" @click="exportJSON">导出 JSON</button>
                  <button class="ab-btn ghost" @click="importData">导入数据</button>
                  <button class="ab-btn danger" @click="clearData">清除数据</button>
                </div>
              </div>

              <!-- 选项：自启 + 排除列表 -->
              <label class="ab-h2">选项</label>
              <div class="ab-section">
                <div class="ab-btns" style="margin-top: 0; align-items: center;">
                  <button class="ab-btn" :class="autostart ? '' : 'ghost'" @click="toggleAutostart()">
                    {{ autostart ? '开机自启：开' : '开机自启：关' }}
                  </button>
                </div>
                <div style="flex-direction: row; gap: 4px; margin-top: 6px;">
                  <input type="text" class="tinput" style="flex-grow: 1; width: auto;" v-model="excludeStr" placeholder="排除记录应用：填写进程名，可用&quot;,&quot;分割"/>
                  <button class="ab-btn" style="width: 72px;" @click="applyExcl">添加排除</button>
                </div>
                <div v-if="excludeList.length" style="flex-direction: row; align-items: flex-start; gap: 12px; margin-top: 6px;">
                  <div v-for="(col, ci) in excludeCols" :key="ci" style="flex-direction: column; gap: 2px; flex-grow: 1; min-width: 0;">
                    <div v-for="(e, ei) in col" :key="ei" style="flex-direction: row; align-items: center; gap: 4px;">
                      <label class="ab-line" style="margin: 0; flex-grow: 1;">{{ e }}</label>
                      <button class="ab-btn ghost" style="width: 44px; padding: 3px 4px; font-size: 11px;" @click="removeExcl(exclRealIndex(ci, ei))">移除</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 隐私与安全 / 开发信息 / 许可 -->
              <label class="ab-h2" style="margin-top: 16px;">隐私与安全</label>
              <div class="ab-section">
                <label class="ab-line" style="margin-top: 0;">· 所有数据仅保存在本机（%APPDATA%\KeyMouseTracker），不联网、不上传、无遥测。</label>
                <label class="ab-line">· 仅统计按键 / 点击次数，不记录按键内容与输入序列。</label>
                <label class="ab-line">· 数据文件可随时导出备份或删除。</label>
              </div>

              <label class="ab-h2">开发信息</label>
              <div class="ab-section">
                <div style="flex-direction: row; align-items: center; gap: 8px;">
                  <label class="ab-line" style="margin-top: 0;">作者：Taumata</label>
                  <button class="ab-link" @click="openLink('https://github.com/Taumata-wwq/KeyMouseTracker')">项目 · GitHub</button>
                </div>
                <label class="ab-line">技术栈：C++17 · core-ui（Direct2D / Direct3D）· QuickJS-NG · lunasvg</label>
                <div style="flex-direction: row; align-items: center; gap: 8px;">
                  <label class="ab-line">参考引用：</label>
                  <button class="ab-link" @click="openLink('https://ghboke.github.io/core-ui/')">core-ui</button>
                  <button class="ab-link" @click="openLink('https://github.com/quickjs-ng/quickjs')">QuickJS-NG</button>
                  <button class="ab-link" @click="openLink('https://github.com/sammycage/lunasvg')">lunasvg</button>
                  <button class="ab-link" @click="openLink('https://howardhinnant.github.io/date_algorithms.html')">Hinnant 日期</button>
                </div>
                <label class="ab-line" style="margin-bottom: 0;">本软件基于 MIT 开源协议发布，代码见上方项目地址。</label>
              </div>
            </div>
          </ScrollView>
        </div>
      </div>
    </div>

    <!-- 日期选择弹窗（统计表/时段-日/周：月历；时段-月：年 + 12 月） -->
    <div v-if="calOpen" class="modal" @click="onModalBgClick" @keydown="onModalKeydown">
      <div class="calcard" @click="onCardClick">
        <div v-if="trendModeIdx == 0 || (trendModeIdx == 2 && heatScope != 2)">
          <div class="calhead">
            <button class="navarrow" @click="calShift(-12)">«</button>
            <button class="navarrow" @click="calShift(-1)">‹</button>
            <label class="caltitle">{{ calY }} 年 {{ calM }} 月</label>
            <button class="navarrow" @click="calShift(1)">›</button>
            <button class="navarrow" @click="calShift(12)">»</button>
          </div>
          <div class="cal-row">
            <label v-for="(w, i) in calWeekNames" :key="i" class="cal-wd">{{ w }}</label>
          </div>
          <div v-for="(wk, wi) in calWeeks" :key="wi" class="cal-row">
            <button v-for="(c, ci) in wk" :key="ci"
                    :class="c.sel ? 'cal-day sel' : (c.d > 0 ? (c.dis ? 'cal-day dis' : 'cal-day') : 'cal-day blank')"
                    :enabled="!c.dis"
                    @click="pickDay(c.d)">{{ c.d > 0 ? c.d : '' }}</button>
          </div>
        </div>
        <div v-if="trendModeIdx == 2 && heatScope == 2">
          <div class="calhead">
            <button class="navarrow" @click="calShift(-12)">«</button>
            <label class="caltitle">{{ calY }} 年</label>
            <button class="navarrow" @click="calShift(12)">»</button>
          </div>
          <div v-for="(r, ri) in monthRows" :key="ri" class="cal-row">
            <button v-for="(mm, mi) in r" :key="mi"
                    :class="mm.sel ? 'cal-cell sel' : (mm.dis ? 'cal-cell dis' : 'cal-cell')"
                    :enabled="!mm.dis"
                    @click="pickMonth(mm.m)">{{ mm.m }}月</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 范围选择弹窗（导出 CSV / JSON / 清除数据）：Q10 确认后带 4 快捷按钮 -->
    <div v-if="rangePickOpen" class="rng-modal">
      <div class="rng-card">
        <label class="rng-title">{{ rangeKind == 'clear' ? '清除日期范围' : '导出日期范围' }}</label>
        <label class="rng-hint">{{ rangeKind == 'clear' ? '删除该范围内的全部统计记录（不可恢复）。' : '导出该范围内的数据；选择起始/结束日期后点确定。' }}</label>
        <div class="rng-row">
          <label class="rng-label">起始</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num" v-model="rangeStartY" min="2000" max="2100"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num sm" v-model="rangeStartM" min="1" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num sm" v-model="rangeStartD" min="1" :max="daysInMonth(rangeStartY, rangeStartM)"/><label class="rng-unit">日</label>
          </div>
        </div>
        <div class="rng-row">
          <label class="rng-label">结束</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num" v-model="rangeEndY" min="2000" max="2100"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num sm" v-model="rangeEndM" min="1" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num sm" v-model="rangeEndD" min="1" :max="daysInMonth(rangeEndY, rangeEndM)"/><label class="rng-unit">日</label>
          </div>
        </div>
        <div class="rng-actions">
          <button class="rng-btn" @click="rangeToday">今日</button>
          <button class="rng-btn" @click="rangeWeek">本周</button>
          <button class="rng-btn" @click="rangeMonth">本月</button>
          <button class="rng-btn" @click="rangeAll">全部</button>
          <div class="spacer"></div>
          <button class="rng-btn" @click="cancelRange">取消</button>
          <button class="rng-btn on" :class="rangeKind == 'clear' ? 'danger' : ''" @click="confirmRange">确定</button>
        </div>
      </div>
    </div>

    <!-- 明细时间范围弹窗（D13/D14）：年/月/日/时/分 5+5 框；4 快捷按钮 -->
    <div v-if="detailRangeOpen" class="rng-modal">
      <div class="rng-card" style="width: 500px;">
        <label class="rng-title">明细时间范围</label>
        <div class="rng-row">
          <label class="rng-label">起始</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num tn y" v-model="detailStartY" min="2000" max="2100"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num tn" v-model="detailStartM" min="1" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num tn" v-model="detailStartD" min="1" :max="daysInMonth(detailStartY, detailStartM)"/><label class="rng-unit">日</label>
            <input type="number" class="rng-input num tn" v-model="detailStartH" min="0" max="23"/><label class="rng-unit">时</label>
            <input type="number" class="rng-input num tn" v-model="detailStartN" min="0" max="59"/><label class="rng-unit">分</label>
          </div>
        </div>
        <div class="rng-row">
          <label class="rng-label">结束</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num tn y" v-model="detailEndY" min="2000" max="2100"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num tn" v-model="detailEndM" min="1" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num tn" v-model="detailEndD" min="1" :max="daysInMonth(detailEndY, detailEndM)"/><label class="rng-unit">日</label>
            <input type="number" class="rng-input num tn" v-model="detailEndH" min="0" max="23"/><label class="rng-unit">时</label>
            <input type="number" class="rng-input num tn" v-model="detailEndN" min="0" max="59"/><label class="rng-unit">分</label>
          </div>
        </div>
        <div class="rng-actions">
          <button class="rng-btn" @click="rangeTodayDetail">今日</button>
          <button class="rng-btn" @click="rangeWeekDetail">本周</button>
          <button class="rng-btn" @click="rangeMonthDetail">本月</button>
          <button class="rng-btn" @click="rangeAllDetail">全部</button>
          <div class="spacer"></div>
          <button class="rng-btn" @click="cancelDetailRange">取消</button>
          <button class="rng-btn on" @click="confirmDetailRange">确定</button>
        </div>
      </div>
    </div>

    <!-- 应用筛选弹窗：全部应用 + 可滚动的应用选项列表（点选即触发 C++ 筛选） -->
    <div v-if="filterPickOpen" class="modal" @click="closeFilterPick">
      <div class="calcard" style="width: 340px; height: 430px; flex-direction: column;" @click="onCardClick">
        <div class="calhead">
          <label class="caltitle">按应用筛选</label>
        </div>
        <ScrollView class="scroll-fill" style="flex-grow: 1; height: 0; width: 100%;">
          <button class="filter-opt" :class="!filterApp ? 'on' : ''" @click="setFilterApp('')">全部应用</button>
          <button v-for="(o, oi) in filterOptions" :key="oi" class="filter-opt"
                  :class="filterApp == o.n ? 'on' : ''" @click="setFilterApp(o.n)">{{ o.n }}</button>
        </ScrollView>
      </div>
    </div>
  </div>
</template>