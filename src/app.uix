<window title="键鼠使用记录" width="1024" height="576" min-width="760" min-height="520" resizable="true" centered="true" frameless="false"/>

<script>
export default {
  data() {
    var now = new Date();
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    return {
      activeView: 'overview',
      // 键盘/鼠标 tab 内子视图切换：heat=热力图 stats=统计表 detail=明细
      keySubView: 'heat',
      mouseSubView: 'heat',
      trendModeIdx: 0,   // 0=日 1=月 2=年 3=周柱状 4=一周×24h 5=单日12×30
      // 多系列勾选（T7 前置）：[按键, 点击, 里程, 活跃] 0/1；C++ 轮询读取映射到 g_trendChart.enabled
      trendSeries: [1, 1, 0, 0],
      // 总览多系列叠加（T7）：[按键, 点击, 里程, 活跃] 0/1；C++ 轮询读取映射到 g_overviewSeries（空=仅 APM）
      overviewSeries: [0, 0, 0, 0],
      // 统计数据由 C++ 按独立键局部推送（S 后缀）：仅内容变化的键会触发绑定重求值
      todayS: null, totalS: null, mouseTodayS: null, mouseAllS: null,
      keyTableS: [], appsS: [], apps24hS: [], storageS: null,
      pausedS: false, autostartS: false, optAppTrackS: false, excludeListS: [],
      pauseCmd: 0,
      autostartCmd: 0,
      exitCmd: 0,
      themeCmd: 0,
      exportCmd: 0,
      importCmd: 0,
      clearCmd: 0,
      linkCmd: 0,      // 关于页开关外部链接（C++ 侧轮询触发 ShellExecuteW）
      linkUrl: '',     // 待打开的链接（与 linkCmd 配套，须在 data 中初始化才能被 C++ 读到）
      dark: true,       // 由 C++ 侧同步（持久化主题偏好）
      compact: false,    // 窗口较窄时数值缩写显示（由 C++ 侧同步）
      excludeStr: '',  // 前台应用排除列表（逗号分隔 exe 名）
      exclCmd: 0,
      removeExclCmd: 0,   // 移除单个排除项
      removeExclName: '', // 要移除的 exe 名
      dateStr: now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()),
      monthStr: now.getFullYear() + '-' + pad(now.getMonth() + 1),
      yearNum: now.getFullYear(),
      weekStr: (function () {   // 本周周一（周模式选中的起始日）
        var w = new Date(now);
        w.setDate(w.getDate() - ((now.getDay() + 6) % 7));
        return w.getFullYear() + '-' + pad(w.getMonth() + 1) + '-' + pad(w.getDate());
      })(),
      tabs: [
        { id: 'overview', label: '总览' },
        { id: 'keys', label: '键盘' },
        { id: 'mouse', label: '鼠标' },
        { id: 'trend', label: '历史' },
        { id: 'settings', label: '设置' }
      ],
      trendModes: [
        { id: 'd', label: '日' },
        { id: 'm', label: '月' },
        { id: 'y', label: '年' }
      ],
      // 日期选择弹窗
      calOpen: false,
      calY: now.getFullYear(),
      calM: now.getMonth() + 1,
      yearPage: Math.max(2020, now.getFullYear() - 4),
      calWeekNames: ['一', '二', '三', '四', '五', '六', '日'],
      // 键盘配列：0=108键 1=87键 2=61键（关于页设置，C++ 持久化）
      kbLayout: 1,
      // 范围选择弹窗（导出 CSV/JSON、清除数据的日期范围；由 C++ 侧开关）
      rangePickOpen: false,
      rangeKind: '',   // "csv" / "json" / "clear"
      // 起始/结束年月日（0 = 不限/全部历史），由弹窗内可调节框编辑
      rangeStartY: 0, rangeStartM: 0, rangeStartD: 0,
      rangeEndY: 0, rangeEndM: 0, rangeEndD: 0,
      rangeStart: '',
      rangeEnd: '',
      rangePickCmd: 0,
      rangeCancelCmd: 0,
      exportCsvCmd: 0,
      exportJsonCmd: 0,
      optAppCmd: 0,
      // 按应用筛选（v0.3.0）：filterApp = 选中应用 exe 名（'' = 全部）；切换置 filterAppCmd++
      filterApp: '',
      filterAppCmd: 0,
      filterPickOpen: false   // 应用筛选弹窗
    };
  },
  computed: {
    paused() { return !!this.pausedS; },
    autostart() { return !!this.autostartS; },
    today() { return this.todayS || { keys: 0, clicks: 0, motion: 0 }; },
    total() { return this.totalS || { keys: 0, clicks: 0, days: 0, activeSec: 0 }; },
    mouse() { return this.mouseTodayS || { left: 0, right: 0, mid: 0, total: 0 }; },
    mouseAll() { return this.mouseAllS || { left: 0, right: 0, mid: 0, total: 0, motion: 0 }; },
    storage() { return this.storageS || { bytes: 0, days: 0, first: '', last: '' }; },
    apps() { return this.appsS || []; },
    apps24h() {
      var a = this.apps24hS || [];
      if (!a.length) return a;
      var max = a[0].c || 1;
      for (var i = 0; i < a.length; i++) {
        a[i].barW = Math.round(a[i].c * 100 / max);
        a[i].barCls = 'bw-' + (Math.round(a[i].barW / 5) * 5);
      }
      return a;
    },
    optAppTrack() { return !!this.optAppTrackS; },
    // 应用筛选选项：合并 今日应用排行(appsS) + 近24h(apps24hS)，按次数降序去重取前 20
    filterOptions() {
      var m = {};
      var add = function (a) {
        for (var i = 0; i < a.length; i++) {
          var it = a[i];
          if (!it || !it.n) continue;
          if (!m[it.n] || m[it.n].c < (it.c || 0)) m[it.n] = { n: it.n, c: it.c || 0 };
        }
      };
      add(this.apps);
      add(this.apps24h);
      var out = [];
      for (var k in m) out.push(m[k]);
      out.sort(function (x, y) { return y.c - x.c; });
      if (out.length > 20) out = out.slice(0, 20);
      return out;
    },
    excludeList() { return this.excludeListS || []; },
    keyTable() { return this.keyTableS || []; },
    keyMax() {
      var t = this.keyTable;
      if (!t || !t.length) return 1;
      var mx = 0;
      for (var i = 0; i < t.length; i++) {
        var v = t[i].c;
        if (v > mx) mx = v;
      }
      return mx > 0 ? mx : 1;
    },
    mouseMax() {
      var m = this.mouseAll;
      // 仅点击量相互比较（移动采样是不同的量纲、数值通常远超点击，单独成条），
      // 否则移动数值会把点击条全压扁成“满值”观感，失去对比。
      return Math.max(m.left || 0, m.right || 0, m.mid || 0, m.total || 0, 1);
    },
    mouseTodayMax() {
      var m = this.mouse;
      return Math.max(m.left || 0, m.right || 0, m.mid || 0, m.total || 0, 1);
    },
    // 日历网格（周一为首列，6 行 × 7 列；d=0 表示空白格）
    calWeeks() {
      var y = this.calY, m = this.calM;
      var first = new Date(y, m - 1, 1);
      var offset = (first.getDay() + 6) % 7;
      var dim = new Date(y, m, 0).getDate();
      var selD = 0;
      var p = String(this.dateStr).split('-');
      if (p.length >= 3 && parseInt(p[0]) == y && parseInt(p[1]) == m) selD = parseInt(p[2]);
      var cells = [];
      for (var i = 0; i < offset; ++i) cells.push({ d: 0, sel: false });
      for (var d = 1; d <= dim; ++d) cells.push({ d: d, sel: d == selD });
      while (cells.length % 7 != 0) cells.push({ d: 0, sel: false });
      var rows = [];
      for (var i = 0; i < cells.length; i += 7) rows.push(cells.slice(i, i + 7));
      return rows;
    },
    // 月选择网格（3 行 × 4 列）
    monthRows() {
      var pm = String(this.monthStr).split('-');
      var selY = parseInt(pm[0]) || 0, selM = parseInt(pm[1]) || 0;
      var rows = [];
      for (var r = 0; r < 3; ++r) {
        var row = [];
        for (var c = 0; c < 4; ++c) {
          var m = r * 4 + c + 1;
          row.push({ m: m, sel: this.calY == selY && m == selM });
        }
        rows.push(row);
      }
      return rows;
    },
    // 年选择网格（3 行 × 4 列，共 12 年）
    yearRows() {
      var selY = parseInt(this.yearNum) || 0;
      var rows = [];
      for (var r = 0; r < 3; ++r) {
        var row = [];
        for (var c = 0; c < 4; ++c) {
          var y = this.yearPage + r * 4 + c;
          row.push({ y: y, sel: y == selY });
        }
        rows.push(row);
      }
      return rows;
    }
  },
  methods: {
    go(v) { this.activeView = v; },
    setMode(i) { this.trendModeIdx = i; },
    toggleSeries(i) {
      var next = this.trendSeries.slice();
      next[i] = next[i] ? 0 : 1;
      // 至少保留一个系列：enabled 为空在 timechart 中语义为“全部显示”，会违背勾选意图
      if (next[0] || next[1] || next[2] || next[3]) this.trendSeries = next;
    },
    toggleOverviewSeries(i) {
      var next = this.overviewSeries.slice();
      next[i] = next[i] ? 0 : 1;
      this.overviewSeries = next;
    },
    // ---- 日期便携步进 ----
    pad2(n) { return (n < 10 ? '0' : '') + n; },
    // 周一（周模式选中范围的起始日）
    mondayYMD(y, m, d) {
      var dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() - ((dt.getDay() + 6) % 7));
      return dt.getFullYear() + '-' + this.pad2(dt.getMonth() + 1) + '-' + this.pad2(dt.getDate());
    },
    stepDate(mode, n) {   // mode: 0=日 ±n天, 4=本周时段 ±n天(±7)
      var target = (mode == 4) ? this.weekStr : this.dateStr;
      var p = String(target || '').split('-');
      var dt = new Date(parseInt(p[0]) || 2000, (parseInt(p[1]) || 1) - 1, (parseInt(p[2]) || 1) + n);
      var s = dt.getFullYear() + '-' + this.pad2(dt.getMonth() + 1) + '-' + this.pad2(dt.getDate());
      if (mode == 4) this.weekStr = s; else this.dateStr = s;
    },
    stepMonth(n) {
      var p = String(this.monthStr || '').split('-');
      var dt = new Date(parseInt(p[0]) || 2000, (parseInt(p[1]) || 1) - 1 + n, 1);
      this.monthStr = dt.getFullYear() + '-' + this.pad2(dt.getMonth() + 1);
    },
    stepYear(n) {
      var y = (parseInt(this.yearNum) || 2000) + n;
      if (y < 2020) y = 2020;
      this.yearNum = y;
    },
    togglePause() { this.pauseCmd = this.pauseCmd + 1; },
    toggleAutostart() { this.autostartCmd = this.autostartCmd + 1; },
    toggleTheme() { this.themeCmd = this.themeCmd + 1; },
    toggleOptApp() { this.optAppCmd = this.optAppCmd + 1; },
    // ---- 按应用筛选（v0.3.0）----
    openFilterPick() { this.filterPickOpen = true; },
    closeFilterPick() { this.filterPickOpen = false; },
    // name 为 '' 表示「全部应用」；写入 filterApp 并递增命令，C++ 轮询切换筛选
    setFilterApp(name) { this.filterApp = name || ''; this.filterAppCmd++; this.filterPickOpen = false; },
    applyExcl() { this.exclCmd++; },
    removeExcl(i) { this.removeExclName = this.excludeList[i]; this.removeExclCmd++; },
    requestExit() { this.exitCmd = this.exitCmd + 1; },
    exportData() { this.exportCmd = this.exportCmd + 1; },
    importData() { this.importCmd = this.importCmd + 1; },
    clearData() { this.initRangeFields(); this.clearCmd = this.clearCmd + 1; },
    exportCSV() { this.initRangeFields(); this.exportCsvCmd = this.exportCsvCmd + 1; },
    exportJSON() { this.initRangeFields(); this.exportJsonCmd = this.exportJsonCmd + 1; },
    // 打开范围弹窗前按数据实际覆盖范围（或今天）预填起始/结束
    initRangeFields() {
      var parse = function (s) {
        var p = String(s || '').split('-');
        if (p.length >= 3) return { y: parseInt(p[0]) || 0, m: parseInt(p[1]) || 0, d: parseInt(p[2]) || 0 };
        return null;
      };
      var st = parse(this.storage.first);
      var en = parse(this.storage.last);
      var now = new Date();
      if (!st) st = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
      if (!en) en = st;
      this.rangeStartY = st.y; this.rangeStartM = st.m; this.rangeStartD = st.d;
      this.rangeEndY = en.y; this.rangeEndM = en.m; this.rangeEndD = en.d;
    },
    ymdStr(y, m, d) {
      if (!y || !m || !d) return '';
      return y + '-' + this.pad2(m) + '-' + this.pad2(d);
    },
    confirmRange() {
      this.rangeStart = this.ymdStr(this.rangeStartY, this.rangeStartM, this.rangeStartD);
      this.rangeEnd = this.ymdStr(this.rangeEndY, this.rangeEndM, this.rangeEndD);
      this.rangePickCmd = this.rangePickCmd + 1;
    },
    // 全部历史 = 恢复为完整数据范围（最早 ~ 最晚），而不是归零
    rangeAll() { this.initRangeFields(); },
    cancelRange() { this.rangeCancelCmd = this.rangeCancelCmd + 1; this.rangePickOpen = false; },
      openLink(u) { this.linkUrl = u; this.linkCmd++; },
    fmt(v) {
      if (v == null || v === '') return '0';
      // 默认显示准确值；窗口过窄（compact 由 C++ resize 回调同步）时才缩写
      if (!this.compact) return String(v);
      if (v >= 1000000000) return (v / 1000000000).toFixed(1) + 'B';
      if (v >= 1000000) return (v / 1000000).toFixed(1) + 'M';
      if (v >= 1000) return (v / 1000).toFixed(1) + 'K';
      return String(v);
    },
    fmtMin(sec) {
      // 累计活跃时间显示为“一位小数小时”格式，单位缩写为 h
      var h = (sec || 0) / 3600;
      return h.toFixed(1) + 'h';
    },
    // 里程（厘米）→ 可读距离：km / m / cm
    fmtDist(cm) {
      var c = cm || 0;
      if (c >= 100000) return (c / 100000).toFixed(2) + ' km';
      if (c >= 1000) return (c / 100).toFixed(1) + ' m';
      return c + ' cm';
    },
    // 字节数 → 可读大小（B / KB / MB）
    fmtBytes(b) {
      var n = b || 0;
      if (n >= 1048576) return (n / 1048576).toFixed(2) + ' MB';
      if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
      return n + ' B';
    },
    // 计数条宽度百分比：钳制到 [0,100]，并保证有值的最短可见条，避免除零/满值溢出
    pct(c, m) {
      var mx = (m && m > 0) ? m : 1;
      var p = Math.round(c / mx * 100);
      if (!isFinite(p) || p < 0) p = 0;
      if (p > 100) p = 100;
      if (p > 0 && p < 2) p = 2;
      return p;
    },
    // ---- 日期选择弹窗 ----
    openCal() {
      var now = new Date();
      if (this.trendModeIdx == 0 || this.trendModeIdx == 5) {   // 按日 / 单日12×30：月历
        var p = String(this.dateStr).split('-');
        this.calY = parseInt(p[0]) || now.getFullYear();
        this.calM = parseInt(p[1]) || (now.getMonth() + 1);
      } else if (this.trendModeIdx == 4) {   // 本周时段：以周一所在月份打开月历
        var p = String(this.weekStr).split('-');
        this.calY = parseInt(p[0]) || now.getFullYear();
        this.calM = parseInt(p[1]) || (now.getMonth() + 1);
      } else if (this.trendModeIdx == 1) {
        var p = String(this.monthStr).split('-');
        this.calY = parseInt(p[0]) || now.getFullYear();
      } else {
        this.yearPage = Math.max(2020, (parseInt(this.yearNum) || now.getFullYear()) - 4);
      }
      this.calOpen = true;
    },
    closeCal() { this.calOpen = false; },
    calShift(n) { // n = 月数（±1 月，±12 年）
      var m = this.calM + n, y = this.calY;
      while (m > 12) { m -= 12; y += 1; }
      while (m < 1) { m += 12; y -= 1; }
      this.calY = y;
      this.calM = m;
    },
    shiftYears(n) { this.yearPage = Math.max(2020, this.yearPage + n); },
    pickDay(d) {
      if (d <= 0) return;
      if (this.trendModeIdx == 4) {
        this.weekStr = this.mondayYMD(this.calY, this.calM, d);   // 本周时段：选中日所在周
      } else {
        this.dateStr = this.calY + '-' + this.pad2(this.calM) + '-' + this.pad2(d);
      }
      this.closeCal();
    },
    pickMonth(m) {
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      this.monthStr = this.calY + '-' + pad(m);
      this.closeCal();
    },
    pickYear(y) {
      this.yearNum = y;
      this.closeCal();
    },
    onModalBgClick() { this.closeCal(); },
    onCardClick() { },
    onModalKeydown() { this.closeCal(); }
  }
}
</script>

<style>
  /* 颜色统一走库主题令牌（var(--...)），深浅主题切换由 C++ 侧 ui_theme_set_mode 驱动 */
  .app { width: 100%; height: 100%; flex-direction: column; background: var(--window-bg); }

  .nav { flex-direction: row; align-items: center; gap: 4px;
         padding: 0 14px; height: 52px; background: var(--card-bg);
         box-shadow: 0 1px 0 var(--border-subtle); }
  .navtab { padding: 6px 14px; border-radius: 8px; color: var(--fg-2);
            font-size: 13px; cursor: pointer; background: transparent; }
  .navtab:hover { background: var(--bg-3); }
  .navtab.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .spacer { flex-grow: 1; }
  /* 右侧方形按钮：采集状态 + 主题切换（与导航标签风格一致） */
  .circle-btn { width: 40px; padding: 6px 0; border-radius: 8px; font-size: 13px;
                cursor: pointer; border: none; flex: none;
                display: flex; align-items: center; justify-content: center;
                background: var(--bg-3); color: var(--fg-2); }
  .st-run { background: #1f9d55; color: #ffffff; }        /* 采集中：绿 */
  .st-paused { background: #d97706; color: #ffffff; }     /* 已暂停：橙 */
  .st-theme-light { background: #f59e0b; color: #ffffff; } /* 当前浅色：琥珀 */
  .st-theme-dark { background: #475569; color: #f1f5f9; } /* 当前深色：石板 */

  /* 24h 应用占比进度条宽度（5% 步进） */
  .bw-0{width:0%} .bw-5{width:5%} .bw-10{width:10%} .bw-15{width:15%} .bw-20{width:20%}
  .bw-25{width:25%} .bw-30{width:30%} .bw-35{width:35%} .bw-40{width:40%} .bw-45{width:45%}
  .bw-50{width:50%} .bw-55{width:55%} .bw-60{width:60%} .bw-65{width:65%} .bw-70{width:70%}
  .bw-75{width:75%} .bw-80{width:80%} .bw-85{width:85%} .bw-90{width:90%} .bw-95{width:95%}
  .bw-100{width:100%}

  .content { flex-grow: 1; width: 100%; height: 0; overflow: hidden; }
  .view { width: 100%; height: 100%; padding: 20px; gap: 16px; flex-direction: column; overflow: hidden; }

  /* 总览：7 项 KPI 分两行（4 + 3，末尾占位保持等宽） */
  .kpiwrap { flex-direction: column; gap: 10px; }
  .kpis { flex-direction: row; gap: 10px; }
  .kpi2 { flex-grow: 1; background: var(--card-bg); border-radius: 8px;
          padding: 10px 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);
          flex-direction: row; align-items: center; justify-content: space-between; }
  .kpi2 .t { font-size: 12px; color: var(--fg-3); }
  .kpi2 .v { font-size: 17px; font-weight: 600; color: #4d9fff; }
  .kpi-fill { flex-grow: 1; }
  /* 今日活跃/空闲/专注摘要行 */
  .kpi-mini { font-size: 12px; color: var(--fg-3); text-align: left; margin-top: 2px; }

  .section { background: var(--card-bg); border-radius: 10px; padding: 16px 18px;
             box-shadow: 0 1px 2px rgba(0,0,0,0.04); flex-direction: column; overflow: hidden;
             contain: layout style; }
  .section-title { font-size: 12px; font-weight: 600; color: var(--fg-3); text-align: center;
                   margin-bottom: 2px; }
  .flush { flex: 1 1 auto; min-height: 0; height: 0; }

  .kbd-table { width: 100%; flex-direction: column; gap: 2px; }
  .kt-row { flex-direction: row; align-items: center; padding: 8px 10px;
            border-radius: 6px; }
  .kt-row:hover { background: var(--bg-3); }
  .kt-label { font-size: 13px; color: var(--fg); width: 140px; }
  /* 原生 progressbar：内部按 value/(max-min) 比例填充，:value 绑定真实反应式更新 */
  .kt-bar { flex-grow: 1; height: 8px; }
  .kt-count { width: 90px; text-align: right; font-size: 13px; color: var(--fg-2); }

  .mouse-grid { flex-direction: column; gap: 8px; }
  .mouse-grid2 { flex-direction: row; gap: 20px; }
  .mouse-col { flex: 1; flex-direction: column; gap: 4px; }
  .mouse-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 8px 10px;
               border-radius: 6px; }
  .mouse-row:hover { background: var(--bg-3); }
  .mouse-row2 { flex-direction: row; align-items: center; justify-content: space-between; padding: 7px 10px;
                border-radius: 6px; }
  .mouse-row2:hover { background: var(--bg-3); }
  .mouse-name { font-size: 13px; color: var(--fg); width: 140px; }
  .mouse-name2 { font-size: 13px; color: var(--fg); }
  .mouse-bar { flex-grow: 1; height: 8px; }
  .mouse-val { width: 90px; text-align: right; font-size: 13px; color: var(--fg-2); font-weight: 600; }
  .mouse-val2 { text-align: right; font-size: 14px; color: #4d9fff; font-weight: 600; }
  .mouse-h { font-size: 12px; color: var(--fg-3); margin-top: 6px; }

  .canvas { flex-grow: 1; width: 100%; min-height: 0; }
  .scroll-fill { flex: 1 1 auto; width: 100%; min-height: 0; height: 0; overflow-y: auto; overflow-x: hidden; }

  .modes { flex-direction: row; gap: 6px; }
  .mode { padding: 5px 12px; border-radius: 7px; font-size: 12px; color: var(--fg-2);
          cursor: pointer; background: var(--bg-3); }
  .mode.on { background: var(--accent); color: var(--fg-on-accent); }
  .ctrlbar { flex-direction: row; align-items: center; gap: 8px; margin-bottom: 10px; }
  /* 应用筛选（v0.3.0）：弹窗选项按钮 + 入口按钮选中态 */
  .filter-opt { width: 100%; padding: 8px 12px; border-radius: 6px; font-size: 12px;
                cursor: pointer; background: transparent; color: var(--fg-2);
                text-align: left; white-space: nowrap; overflow: hidden; flex: none; }
  .filter-opt:hover { background: var(--bg-3); }
  .filter-opt.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .calbtn.on { background: var(--accent); color: var(--fg-on-accent); }
  /* 历史视图：多系列勾选行（T7） */
  .seriesbar { flex-direction: row; align-items: center; gap: 6px; margin-bottom: 10px; }
  .series-title { font-size: 12px; color: var(--fg-3); margin-right: 2px; flex: none; }

  .tinput { background: var(--input-bg); border: 1px solid var(--input-border);
            border-radius: 6px; padding: 5px 10px; font-size: 12px; color: var(--fg);
            width: 118px; }
  .calbtn { padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;
            background: var(--bg-3); color: var(--fg-2); }
  /* 日期便携步进调整：文本框两侧 ‹ › */
  .datebox { flex-direction: row; align-items: center; gap: 4px; }
  .stepper { width: 24px; height: 26px; border-radius: 6px; font-size: 14px; cursor: pointer;
             background: var(--bg-3); color: var(--fg-2); text-align: center;
             display: flex; align-items: center; justify-content: center; padding: 0; }
  .stepper:hover { background: var(--bg-2); color: var(--fg); }

  /* 日期选择弹窗（覆盖全窗口，点击遮罩关闭） */
  .modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
           background: rgba(0,0,0,0.35); flex-direction: row;
           justify-content: center; align-items: center; }
  .calcard { background: var(--card-bg); border-radius: 10px; padding: 14px;
             box-shadow: 0 10px 30px rgba(0,0,0,0.30); }
  .calhead { flex-direction: row; align-items: center; gap: 6px; margin-bottom: 8px; }
  .caltitle { flex-grow: 1; text-align: center; font-size: 13px; color: var(--fg);
              font-weight: 600; }
  .navarrow { width: 28px; height: 28px; border-radius: 6px; font-size: 14px; cursor: pointer;
              background: var(--bg-3); color: var(--fg-2); text-align: center;
              display: flex; align-items: center; justify-content: center; padding: 0; }
  .cal-row { flex-direction: row; gap: 4px; margin-bottom: 4px; }
  .cal-wd { width: 34px; text-align: center; font-size: 11px; color: var(--fg-3); }
  .cal-day { width: 34px; height: 30px; text-align: center; font-size: 12px;
             color: var(--fg); background: var(--bg-3); border-radius: 6px; cursor: pointer; }
  .cal-day.blank { background: transparent; cursor: default; }
  .cal-day.sel { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  .cal-cell { width: 64px; height: 32px; text-align: center; font-size: 12px;
              color: var(--fg); background: var(--bg-3); border-radius: 6px; cursor: pointer; }
  .cal-cell.sel { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }

  /* 范围选择弹窗（导出 CSV/JSON、清除数据的日期范围） */
  .rng-modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
               background: rgba(0,0,0,0.35); flex-direction: row;
               justify-content: center; align-items: center; }
  .rng-card { background: var(--card-bg); border-radius: 10px; padding: 16px;
              box-shadow: 0 10px 30px rgba(0,0,0,0.30); width: 480px;
              flex-direction: column; gap: 10px; }
  .rng-title { font-size: 14px; font-weight: 600; color: var(--fg); }
  .rng-hint { font-size: 12px; color: var(--fg-3); }
  .rng-row { flex-direction: row; align-items: center; gap: 8px; }
  .rng-label { font-size: 12px; color: var(--fg-2); width: 42px; flex: none; }
  .rng-input { background: var(--input-bg); border: 1px solid var(--input-border);
               border-radius: 6px; padding: 5px 8px; font-size: 12px; color: var(--fg);
               flex-grow: 1; }
  /* 年月日三组可调节：number 输入自带步进，仅并排 + 单位（再加宽一倍保证数字完整显示） */
  .rng-date3 { flex-direction: row; align-items: center; gap: 4px; flex-grow: 1; }
  .rng-input.num { width: 128px; flex: none; text-align: center; padding: 4px 2px; }
  .rng-input.num.sm { width: 96px; }
  .rng-unit { font-size: 11px; color: var(--fg-3); width: 14px; text-align: center; flex: none; }
  .rng-actions { flex-direction: row; align-items: center; gap: 8px; margin-top: 4px; }
  .rng-btn { padding: 6px 14px; border-radius: 6px; font-size: 12px; cursor: pointer;
             background: var(--bg-3); color: var(--fg-2); flex: none; white-space: nowrap; }
  .rng-btn.on { background: var(--accent); color: var(--fg-on-accent); }
  .rng-btn.danger { background: #b42318; color: #ffffff; }

  /* 关于页 */
  .ab-title { font-size: 18px; font-weight: 600; color: var(--fg); margin-bottom: 8px; }
  .ab-h2 { font-size: 13px; font-weight: 600; color: var(--fg); margin-bottom: 6px; margin-top: 12px; }
  .ab-line { font-size: 12px; color: var(--fg-2); margin-bottom: 3px; line-height: 1.5; }
  .ab-btns { flex-direction: row; gap: 10px; margin: 4px 0; }
  /* 固定显式宽度：避免任何测量上下文缺失导致的"滚动后按钮变窄"，无论是否
   * 重跑布局都保持稳定几何（开机自启按钮文本最长）。这里将宽度整体收窄。 */
  .ab-btn { padding: 8px 12px; border-radius: 8px; font-size: 13px; cursor: pointer;
          background: var(--accent); color: var(--fg-on-accent);
          flex: none; white-space: nowrap; width: 112px; }
  .ab-btn.ghost { background: var(--bg-3); color: var(--fg-2); }
  .ab-btn.danger { background: #b42318; color: #ffffff; }
  /* 数据管理三按钮文本较短，单独收窄到 80px */
  .ab-btns.data .ab-btn { width: 80px; padding: 8px 8px; }
  /* 配列切换按钮（108/87/61） */
  .laybtn { padding: 8px 12px; border-radius: 8px; font-size: 13px; cursor: pointer;
            background: var(--bg-3); color: var(--fg-2);
            flex: none; white-space: nowrap; width: 68px; }
  .laybtn.on { background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
  /* 关于页外部链接按钮（作者 / 项目 / 参考引用）。文字色取与总览数据一致的浅蓝，
   * 在暗色下保持浅色可读（深蓝会看不清）。与上方设置按钮(.ab-btn)采用同一套
   * “固定显式宽度”设计逻辑：宽度写死，避免滚动后/重新布局时测宽漂移导致按钮大小变化。 */
  .ab-link { padding: 6px 10px; border-radius: 8px; font-size: 12px; cursor: pointer;
            background: var(--bg-3); color: #4d9fff;
            flex: none; white-space: nowrap; width: 118px; text-align: center; }
  .ab-link:hover { background: var(--accent); color: var(--fg-on-accent); }
  .ab-section { background: var(--bg-2); border-radius: 8px; padding: 10px 14px; margin-bottom: 8px; }
  /* 里程碑徽章 */
  .ms-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px;
              background: var(--accent); color: var(--fg-on-accent); white-space: nowrap; }
</style>

<template>
  <div class="app">
    <div class="nav">
      <button v-for="(t, i) in tabs" :key="t.id"
              :class="activeView == t.id ? 'navtab on' : 'navtab'"
              @click="go(t.id)">{{ t.label }}</button>
      <div class="spacer"></div>
      <button class="circle-btn" :class="paused ? 'st-paused' : 'st-run'" @click="togglePause"
              :title="paused ? '已暂停' : '采集中'">
        {{ paused ? '关' : '开' }}
      </button>
      <button class="circle-btn" :class="dark ? 'st-theme-dark' : 'st-theme-light'" @click="toggleTheme"
              :title="dark ? '切换浅色' : '切换深色'">
        {{ dark ? '☀' : '🌙' }}
      </button>
    </div>

    <div class="content">
      <!-- 总览：KPI 卡片 + 活跃/空闲 + 里程碑 + 活跃应用 -->
      <div v-if="activeView == 'overview'" class="view">
        <div class="kpiwrap">
          <div class="kpis">
            <div class="kpi2"><label class="t">今日按键</label><label class="v">{{ fmt(today.keys) }}</label></div>
            <div class="kpi2"><label class="t">今日点击</label><label class="v">{{ fmt(today.clicks) }}</label></div>
            <div class="kpi2"><label class="t">今日里程</label><label class="v">{{ fmtDist(today.distCm) }}</label></div>
            <div class="kpi2"><label class="t">今日活跃</label><label class="v">{{ fmtMin(today.activeSec) }}</label></div>
          </div>
          <div class="kpis">
            <div class="kpi2"><label class="t">累计按键</label><label class="v">{{ fmt(total.keys) }}</label></div>
            <div class="kpi2"><label class="t">累计点击</label><label class="v">{{ fmt(total.clicks) }}</label></div>
            <div class="kpi2"><label class="t">累计里程</label><label class="v">{{ fmtDist(total.distCm) }}</label></div>
            <div class="kpi2"><label class="t">累计活跃</label><label class="v">{{ fmtMin(total.activeSec) }}</label></div>
          </div>
        </div>
        <div class="section flush" style="flex-direction: row; gap: 10px; padding: 0; background: transparent; box-shadow: none; margin-top: -6px;">
          <!-- 24h 应用活动占比（左侧，与上方 KPI 等宽） -->
          <div v-if="optAppTrack && apps24h.length" class="section" style="flex:1; padding: 10px 12px; flex-direction: column;">
            <label class="section-title">24h应用活动占比</label>
            <ScrollView style="flex-grow: 1; height: 0; margin-top: 6px;">
              <div v-for="(a, ai) in apps24h" :key="ai" style="flex-direction: row; align-items: center; gap: 6px; height: 28px; flex: none; padding: 2px 4px 2px 0;">
                <label style="width: 34px; text-align: right; font-size: 12px; color: var(--fg-2); flex: none; white-space: nowrap; margin-left: -8px;">{{ a.p }}%</label>
                <progressbar class="kt-bar" style="min-width: 40px;" min="0" max="100" :value="a.barW"></progressbar>
                <label style="width: 96px; text-align: right; font-size: 11px; color: var(--fg); flex-shrink: 1; white-space: nowrap;">{{ a.n }}</label>
              </div>
            </ScrollView>
          </div>
          <!-- 24h 键鼠活动趋势（右侧） -->
          <div class="section" style="flex:3.08; padding: 10px 12px; flex-direction: column;">
            <div style="flex-direction: row; align-items: center; gap: 6px; margin-bottom: 2px;">
              <label class="section-title" style="flex: none;">24h键鼠活动趋势</label>
              <div style="flex-grow: 1;"></div>
              <!-- 多系列叠加（T7）：overviewSeries 勾选才在 APM 曲线上叠加对应折线，全不勾=仅 APM -->
              <button class="mode" :class="overviewSeries[0] ? 'on' : ''" @click="toggleOverviewSeries(0)" style="padding: 2px 8px; font-size: 11px;">{{ overviewSeries[0] ? '☑' : '☐' }}按键</button>
              <button class="mode" :class="overviewSeries[1] ? 'on' : ''" @click="toggleOverviewSeries(1)" style="padding: 2px 8px; font-size: 11px;">{{ overviewSeries[1] ? '☑' : '☐' }}点击</button>
              <button class="mode" :class="overviewSeries[2] ? 'on' : ''" @click="toggleOverviewSeries(2)" style="padding: 2px 8px; font-size: 11px;">{{ overviewSeries[2] ? '☑' : '☐' }}里程</button>
              <button class="mode" :class="overviewSeries[3] ? 'on' : ''" @click="toggleOverviewSeries(3)" style="padding: 2px 8px; font-size: 11px;">{{ overviewSeries[3] ? '☑' : '☐' }}活跃</button>
            </div>
            <custom id="apm_canvas" class="canvas" style="margin-top: 2px;"></custom>
          </div>
        </div>
      </div>

      <!-- 键盘：热力图 / 统计表 / 明细（视图内切换；原 键盘统计 + 键盘热力图 合并） -->
      <div v-if="activeView == 'keys'" class="view">
        <div class="modes" style="flex: none;">
          <button :class="keySubView == 'heat' ? 'mode on' : 'mode'" @click="keySubView = 'heat'">热力图</button>
          <button :class="keySubView == 'stats' ? 'mode on' : 'mode'" @click="keySubView = 'stats'">统计表</button>
          <button :class="keySubView == 'detail' ? 'mode on' : 'mode'" @click="keySubView = 'detail'">明细</button>
          <div style="flex-grow: 1;"></div>
          <button v-if="optAppTrack && filterOptions.length" class="mode" :class="filterApp ? 'on' : ''"
                  @click="openFilterPick" style="max-width: 200px; white-space: nowrap; overflow: hidden;"
                  :title="filterApp ? '应用筛选：' + filterApp : '应用筛选：全部应用'">应用：{{ filterApp || '全部' }}</button>
        </div>
        <!-- 热力图（custom id 不变，onKeyHeatMount 挂载回调依旧生效） -->
        <div class="section flush" v-if="keySubView == 'heat'">
          <custom id="keyheat_canvas" class="canvas"></custom>
        </div>
        <!-- 统计表：累计按键条块（全部累计） -->
        <div class="section flush" v-if="keySubView == 'stats'">
          <ScrollView class="scroll-fill">
            <div class="kbd-table">
              <div v-for="(r, i) in keyTable" :key="i" class="kt-row">
                <label class="kt-label">{{ r.l }}</label>
                <progressbar class="kt-bar" min="0" max="100" :value="pct(r.c, keyMax)"></progressbar>
                <label class="kt-count">{{ fmt(r.c) }}</label>
              </div>
            </div>
          </ScrollView>
        </div>
        <!-- 明细：纯数字数值列 -->
        <div class="section flush" v-if="keySubView == 'detail'">
          <ScrollView class="scroll-fill">
            <div class="kbd-table">
              <div v-for="(r, i) in keyTable" :key="i" class="kt-row" style="padding: 5px 10px;">
                <label class="kt-label" style="width: 200px;">{{ r.l }}</label>
                <label class="kt-count" style="flex-grow: 1; width: auto; text-align: right;">{{ fmt(r.c) }}</label>
              </div>
            </div>
          </ScrollView>
        </div>
      </div>

      <!-- 鼠标：热力图 / 统计表 / 明细（视图内切换；原 鼠标统计 + 鼠标热力图 合并） -->
      <div v-if="activeView == 'mouse'" class="view">
        <div class="modes" style="flex: none;">
          <button :class="mouseSubView == 'heat' ? 'mode on' : 'mode'" @click="mouseSubView = 'heat'">热力图</button>
          <button :class="mouseSubView == 'stats' ? 'mode on' : 'mode'" @click="mouseSubView = 'stats'">统计表</button>
          <button :class="mouseSubView == 'detail' ? 'mode on' : 'mode'" @click="mouseSubView = 'detail'">明细</button>
          <div style="flex-grow: 1;"></div>
          <button v-if="optAppTrack && filterOptions.length" class="mode" :class="filterApp ? 'on' : ''"
                  @click="openFilterPick" style="max-width: 200px; white-space: nowrap; overflow: hidden;"
                  :title="filterApp ? '应用筛选：' + filterApp : '应用筛选：全部应用'">应用：{{ filterApp || '全部' }}</button>
        </div>
        <!-- 热力图（custom id 不变，onMouseHeatMount 挂载回调依旧生效） -->
        <div class="section flush" v-if="mouseSubView == 'heat'">
          <custom id="mouseheat_canvas" class="canvas"></custom>
        </div>
        <!-- 统计表：今日/全部 点击条块对比（移动为不同量纲，不参与条块） -->
        <div class="section flush" v-if="mouseSubView == 'stats'">
          <ScrollView class="scroll-fill">
            <div class="mouse-grid2">
              <div class="mouse-col">
                <label class="mouse-h">今日</label>
                <div class="mouse-row"><label class="mouse-name">左键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouse.left, mouseTodayMax)"></progressbar><label class="mouse-val">{{ fmt(mouse.left) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">右键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouse.right, mouseTodayMax)"></progressbar><label class="mouse-val">{{ fmt(mouse.right) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">中键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouse.mid, mouseTodayMax)"></progressbar><label class="mouse-val">{{ fmt(mouse.mid) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">总点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouse.total, mouseTodayMax)"></progressbar><label class="mouse-val">{{ fmt(mouse.total) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动采样</label><label class="mouse-val2">{{ fmt(today.motion) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动里程</label><label class="mouse-val2">{{ fmtDist(today.distCm) }}</label></div>
              </div>
              <div class="mouse-col">
                <label class="mouse-h">全部累计</label>
                <div class="mouse-row"><label class="mouse-name">左键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouseAll.left, mouseMax)"></progressbar><label class="mouse-val">{{ fmt(mouseAll.left) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">右键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouseAll.right, mouseMax)"></progressbar><label class="mouse-val">{{ fmt(mouseAll.right) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">中键点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouseAll.mid, mouseMax)"></progressbar><label class="mouse-val">{{ fmt(mouseAll.mid) }}</label></div>
                <div class="mouse-row"><label class="mouse-name">总点击</label><progressbar class="mouse-bar" min="0" max="100" :value="pct(mouseAll.total, mouseMax)"></progressbar><label class="mouse-val">{{ fmt(mouseAll.total) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动采样</label><label class="mouse-val2">{{ fmt(mouseAll.motion) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动里程</label><label class="mouse-val2">{{ fmtDist(total.distCm) }}</label></div>
              </div>
            </div>
          </ScrollView>
        </div>
        <!-- 明细：纯数字（今日 | 全部累计） -->
        <div class="section flush" v-if="mouseSubView == 'detail'">
          <ScrollView class="scroll-fill">
            <div class="mouse-grid2">
              <div class="mouse-col">
                <label class="mouse-h">今日</label>
                <div class="mouse-row2"><label class="mouse-name2">左键点击</label><label class="mouse-val2">{{ fmt(mouse.left) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">右键点击</label><label class="mouse-val2">{{ fmt(mouse.right) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">中键点击</label><label class="mouse-val2">{{ fmt(mouse.mid) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">总点击</label><label class="mouse-val2">{{ fmt(mouse.total) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动采样</label><label class="mouse-val2">{{ fmt(today.motion) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动里程</label><label class="mouse-val2">{{ fmtDist(today.distCm) }}</label></div>
              </div>
              <div class="mouse-col">
                <label class="mouse-h">全部累计</label>
                <div class="mouse-row2"><label class="mouse-name2">左键点击</label><label class="mouse-val2">{{ fmt(mouseAll.left) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">右键点击</label><label class="mouse-val2">{{ fmt(mouseAll.right) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">中键点击</label><label class="mouse-val2">{{ fmt(mouseAll.mid) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">总点击</label><label class="mouse-val2">{{ fmt(mouseAll.total) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动采样</label><label class="mouse-val2">{{ fmt(mouseAll.motion) }}</label></div>
                <div class="mouse-row2"><label class="mouse-name2">移动里程</label><label class="mouse-val2">{{ fmtDist(total.distCm) }}</label></div>
              </div>
            </div>
          </ScrollView>
        </div>
      </div>

      <!-- 历史趋势：本周时段热力(7×24h) + 日/月/年柱状图 -->
      <div v-if="activeView == 'trend'" class="view">
        <div class="section flush">
          <div class="ctrlbar">
            <div class="modes">
              <button id="mode_d" :class="trendModeIdx == 0 ? 'mode on' : 'mode'" @click="setMode(0)">日</button>
              <button id="mode_m" :class="trendModeIdx == 1 ? 'mode on' : 'mode'" @click="setMode(1)">月</button>
              <button id="mode_y" :class="trendModeIdx == 2 ? 'mode on' : 'mode'" @click="setMode(2)">年</button>
              <button id="mode_h" :class="trendModeIdx == 4 ? 'mode on' : 'mode'" @click="setMode(4)">本周时段</button>
              <button id="mode_t" :class="trendModeIdx == 5 ? 'mode on' : 'mode'" @click="setMode(5)">时段12×30</button>
            </div>
            <div class="spacer"></div>
            <div class="datebox" v-if="trendModeIdx == 0 || trendModeIdx == 5">
              <button class="stepper" @click="stepDate(0, -1)">‹</button>
              <input id="date_input" type="date" class="tinput" v-model="dateStr"/>
              <button class="stepper" @click="stepDate(0, 1)">›</button>
            </div>
            <div class="datebox" v-if="trendModeIdx == 4">
              <button class="stepper" @click="stepDate(4, -7)">‹</button>
              <input id="week_input" type="date" class="tinput" v-model="weekStr"/>
              <button class="stepper" @click="stepDate(4, 7)">›</button>
            </div>
            <div class="datebox" v-if="trendModeIdx == 1">
              <button class="stepper" @click="stepMonth(-1)">‹</button>
              <input id="month_input" type="month" class="tinput" v-model="monthStr"/>
              <button class="stepper" @click="stepMonth(1)">›</button>
            </div>
            <div class="datebox" v-if="trendModeIdx == 2">
              <button class="stepper" @click="stepYear(-1)">‹</button>
              <input id="year_input" type="number" class="tinput" v-model="yearNum"
                     min="2020" max="9999"/>
              <button class="stepper" @click="stepYear(1)">›</button>
            </div>
            <button id="calbtn" class="calbtn" @click="openCal">📅</button>
            <button v-if="optAppTrack && filterOptions.length" class="calbtn" :class="filterApp ? 'on' : ''"
                    @click="openFilterPick" style="max-width: 170px; white-space: nowrap; overflow: hidden;"
                    :title="filterApp ? '按应用查看：' + filterApp : '按应用查看：全部应用'">应用：{{ filterApp || '全部' }}</button>
          </div>
          <!-- 多系列勾选（T7 前置）：C++ 读取 trendSeries 映射 g_trendChart.enabled；热力模式无系列概念，隐藏 -->
          <div class="seriesbar" v-if="trendModeIdx == 0 || trendModeIdx == 1 || trendModeIdx == 2">
            <label class="series-title">显示系列</label>
            <button class="mode" :class="trendSeries[0] ? 'on' : ''" @click="toggleSeries(0)">{{ trendSeries[0] ? '☑' : '☐' }}按键</button>
            <button class="mode" :class="trendSeries[1] ? 'on' : ''" @click="toggleSeries(1)">{{ trendSeries[1] ? '☑' : '☐' }}点击</button>
            <button class="mode" :class="trendSeries[2] ? 'on' : ''" @click="toggleSeries(2)">{{ trendSeries[2] ? '☑' : '☐' }}里程</button>
            <button class="mode" :class="trendSeries[3] ? 'on' : ''" @click="toggleSeries(3)">{{ trendSeries[3] ? '☑' : '☐' }}活跃</button>
          </div>
          <custom id="trend_canvas" class="canvas"></custom>
        </div>
      </div>

      <!-- 设置（原 设置 + 关于 合并） -->
      <div v-if="activeView == 'settings'" class="view">
        <div class="section flush">
          <ScrollView class="scroll-fill">
            <div class="mouse-grid">
              <label class="ab-h2" style="margin-top: 0;">存储</label>
              <div class="ab-section">
                <label class="ab-line" style="margin-top: 0;">当前存储：{{ fmtBytes(storage.bytes) }} · {{ storage.days }} 天（{{ storage.first || '—' }} ~ {{ storage.last || '—' }}）</label>
                <div class="ab-btns data" style="margin-top: 6px;">
                  <button class="ab-btn" @click="exportData">备份 .kmt</button>
                  <button class="ab-btn" @click="exportCSV">导出 CSV</button>
                  <button class="ab-btn" @click="exportJSON">导出 JSON</button>
                  <button class="ab-btn ghost" @click="importData">导入数据</button>
                  <button class="ab-btn danger" @click="clearData">清除数据</button>
                </div>
              </div>

              <label class="ab-h2">系统选项</label>
              <div class="ab-section">
                <div class="ab-btns" style="margin-top: 0; align-items: center;">
                  <button class="ab-btn" :class="autostart ? '' : 'ghost'" @click="toggleAutostart()">
                    {{ autostart ? '开机自启：开' : '开机自启：关' }}
                  </button>
                  <label class="ab-line" style="margin: 0;">键盘配列：</label>
                  <button class="laybtn" :class="kbLayout == 0 ? 'on' : ''" @click="kbLayout = 0">108 键</button>
                  <button class="laybtn" :class="kbLayout == 1 ? 'on' : ''" @click="kbLayout = 1">87 键</button>
                  <button class="laybtn" :class="kbLayout == 2 ? 'on' : ''" @click="kbLayout = 2">61 键</button>
                </div>
              </div>

              <label class="ab-h2">统计选项</label>
              <div class="ab-section">
                <div class="ab-btns" style="margin-top: 0; align-items: center;">
                  <button class="ab-btn" style="width: 122px;" :class="optAppTrack ? '' : 'ghost'" @click="toggleOptApp">
                    {{ optAppTrack ? '前台应用统计：开' : '前台应用统计：关' }}
                  </button>
                  <div v-if="optAppTrack" style="flex-direction: row; gap: 4px; flex-grow: 1;">
                    <input type="text" class="tinput" style="flex-grow: 1; width: auto;" v-model="excludeStr" placeholder="exe名,逗号分隔"/>
                    <button class="ab-btn" style="width: 72px;" @click="applyExcl">添加排除</button>
                  </div>
                </div>
                <div v-if="optAppTrack && excludeList.length" style="flex-direction: column; gap: 2px; margin-top: 6px;">
                  <div v-for="(e, ei) in excludeList" :key="ei" style="flex-direction: row; align-items: center; gap: 4px;">
                    <label class="ab-line" style="margin: 0; flex-grow: 1;">{{ e }}</label>
                    <button class="ab-btn ghost" style="width: 44px; padding: 3px 4px; font-size: 11px;" @click="removeExcl(ei)">移除</button>
                  </div>
                </div>
                <!-- 应用排行（v0.3.0）：今日活跃应用列表，点击「下钻」一键按应用筛选 -->
                <div v-if="optAppTrack && apps.length" style="flex-direction: column; gap: 2px; margin-top: 10px;">
                  <label class="ab-h2" style="margin: 0;">今日活跃应用</label>
                  <div v-for="(a, ai) in apps" :key="ai" style="flex-direction: row; align-items: center; gap: 6px;">
                    <label style="flex-grow: 1; font-size: 12px; color: var(--fg); white-space: nowrap; overflow: hidden;">{{ a.n }}</label>
                    <label style="font-size: 12px; color: var(--fg-2); width: 76px; text-align: right; flex: none;">{{ fmt(a.c) }} 次</label>
                    <button class="ab-btn ghost" style="width: 52px; padding: 3px 4px; font-size: 11px;" @click="setFilterApp(a.n)">下钻</button>
                  </div>
                </div>
              </div>

              <!-- 关于（并入设置）：版本 / 隐私 / 开发信息 / 许可 / 主页链接 -->
              <label class="ab-title">键鼠使用记录 v0.3.0</label>
              <label class="ab-line">本地键盘 / 鼠标使用统计工具，统计按键、点击与移动次数。</label>

              <label class="ab-h2" style="margin-top: 16px;">隐私与安全</label>
              <div class="ab-section">
                <label class="ab-line" style="margin-top: 0;">· 所有数据仅保存在本机（%APPDATA%\KeyMouseTracker），不联网、不上传、无遥测。</label>
                <label class="ab-line">· 仅统计按键 / 点击次数，不记录按键内容与输入序列。</label>
                <label class="ab-line">· 数据文件可随时导出备份或删除。</label>
              </div>

              <label class="ab-h2">开发信息</label>
              <div class="ab-section">
                <div style="flex-direction: row; align-items: center; gap: 8px;">
                  <label class="ab-line" style="margin-top: 0;">作者：Taumata</label>
                  <button class="ab-link" @click="openLink('https://github.com/Taumata-wwq/KeyMouseTracker')">项目 · GitHub</button>
                </div>
                <label class="ab-line">技术栈：C++17 · core-ui（Direct2D / Direct3D）· QuickJS-NG · lunasvg</label>
                <div style="flex-direction: row; align-items: center; gap: 8px;">
                  <label class="ab-line">参考引用：</label>
                  <button class="ab-link" @click="openLink('https://ghboke.github.io/core-ui/')">core-ui</button>
                  <button class="ab-link" @click="openLink('https://github.com/quickjs-ng/quickjs')">QuickJS-NG</button>
                  <button class="ab-link" @click="openLink('https://github.com/sammycage/lunasvg')">lunasvg</button>
                  <button class="ab-link" @click="openLink('https://howardhinnant.github.io/date_algorithms.html')">Hinnant 日期</button>
                </div>
                <label class="ab-line" style="margin-bottom: 0;">本软件基于 MIT 开源协议发布，代码见上方项目地址。</label>
              </div>
            </div>
          </ScrollView>
        </div>
      </div>
    </div>

    <!-- 日期选择弹窗（按日：月历；按月：年 + 12 月；按年：12 年分页） -->
    <div v-if="calOpen" class="modal" @click="onModalBgClick" @keydown="onModalKeydown">
      <div class="calcard" @click="onCardClick">
        <div v-if="trendModeIdx == 0 || trendModeIdx == 4 || trendModeIdx == 5">
          <div class="calhead">
            <button class="navarrow" @click="calShift(-12)">«</button>
            <button class="navarrow" @click="calShift(-1)">‹</button>
            <label class="caltitle">{{ calY }} 年 {{ calM }} 月</label>
            <button class="navarrow" @click="calShift(1)">›</button>
            <button class="navarrow" @click="calShift(12)">»</button>
          </div>
          <div class="cal-row">
            <label v-for="(w, i) in calWeekNames" :key="i" class="cal-wd">{{ w }}</label>
          </div>
          <div v-for="(wk, wi) in calWeeks" :key="wi" class="cal-row">
            <button v-for="(c, ci) in wk" :key="ci"
                    :class="c.sel ? 'cal-day sel' : (c.d > 0 ? 'cal-day' : 'cal-day blank')"
                    @click="pickDay(c.d)">{{ c.d > 0 ? c.d : '' }}</button>
          </div>
        </div>
        <div v-if="trendModeIdx == 1">
          <div class="calhead">
            <button class="navarrow" @click="calShift(-12)">«</button>
            <label class="caltitle">{{ calY }} 年</label>
            <button class="navarrow" @click="calShift(12)">»</button>
          </div>
          <div v-for="(r, ri) in monthRows" :key="ri" class="cal-row">
            <button v-for="(mm, mi) in r" :key="mi"
                    :class="mm.sel ? 'cal-cell sel' : 'cal-cell'"
                    @click="pickMonth(mm.m)">{{ mm.m }}月</button>
          </div>
        </div>
        <div v-if="trendModeIdx == 2">
          <div class="calhead">
            <button class="navarrow" @click="shiftYears(-12)">«</button>
            <label class="caltitle">{{ yearPage }} – {{ yearPage + 11 }}</label>
            <button class="navarrow" @click="shiftYears(12)">»</button>
          </div>
          <div v-for="(r, ri) in yearRows" :key="ri" class="cal-row">
            <button v-for="(yy, yi) in r" :key="yi"
                    :class="yy.sel ? 'cal-cell sel' : 'cal-cell'"
                    @click="pickYear(yy.y)">{{ yy.y }}</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 范围选择弹窗（导出 CSV / JSON / 清除数据） -->
    <div v-if="rangePickOpen" class="rng-modal">
      <div class="rng-card">
        <label class="rng-title">{{ rangeKind == 'clear' ? '清除日期范围' : '导出日期范围' }}</label>
        <label class="rng-hint">{{ rangeKind == 'clear' ? '删除该范围内的全部统计记录（不可恢复）。' : '导出该范围内的数据；任一项为 0 表示该侧不限。' }}</label>
        <div class="rng-row">
          <label class="rng-label">起始</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num" v-model="rangeStartY" min="0" max="9999"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num sm" v-model="rangeStartM" min="0" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num sm" v-model="rangeStartD" min="0" max="31"/><label class="rng-unit">日</label>
          </div>
        </div>
        <div class="rng-row">
          <label class="rng-label">结束</label>
          <div class="rng-date3">
            <input type="number" class="rng-input num" v-model="rangeEndY" min="0" max="9999"/><label class="rng-unit">年</label>
            <input type="number" class="rng-input num sm" v-model="rangeEndM" min="0" max="12"/><label class="rng-unit">月</label>
            <input type="number" class="rng-input num sm" v-model="rangeEndD" min="0" max="31"/><label class="rng-unit">日</label>
          </div>
        </div>
        <div class="rng-actions">
          <button class="rng-btn" @click="rangeAll">全部历史</button>
          <div class="spacer"></div>
          <button class="rng-btn" @click="cancelRange">取消</button>
          <button class="rng-btn on" :class="rangeKind == 'clear' ? 'danger' : ''" @click="confirmRange">确定</button>
        </div>
      </div>
    </div>

    <!-- 应用筛选弹窗（v0.3.0）：全部应用 + 可滚动的应用选项列表（点选即触发 C++ 筛选） -->
    <div v-if="filterPickOpen" class="modal" @click="closeFilterPick">
      <div class="calcard" style="width: 340px; height: 430px; flex-direction: column;" @click="onCardClick">
        <div class="calhead">
          <label class="caltitle">按应用筛选</label>
        </div>
        <ScrollView class="scroll-fill" style="flex-grow: 1; height: 0; width: 100%;">
          <button class="filter-opt" :class="!filterApp ? 'on' : ''" @click="setFilterApp('')">全部应用</button>
          <button v-for="(o, oi) in filterOptions" :key="oi" class="filter-opt"
                  :class="filterApp == o.n ? 'on' : ''" @click="setFilterApp(o.n)">{{ o.n }}</button>
        </ScrollView>
      </div>
    </div>
  </div>
</template>